<Window x:Class="DPC.Views.ItemManager.Consumables.EditConsumables"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Consumable"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Width="450"
        Height="Auto">

    <Grid>
        <materialDesign:Card Width="420" Padding="20" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Edit Consumable" FontSize="20" FontWeight="Bold" Foreground="Black" />
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Click="ClosePopup" Background="Transparent" Foreground="Black">
                        <materialDesign:PackIcon Kind="Close" />
                    </Button>
                </Grid>

                <Separator Margin="0,10,0,10"/>

                <TextBlock Text="Name:" FontSize="14" />
                <Border Style="{StaticResource RoundedBorderStyle}">
                    <TextBox x:Name="txtName" Style="{StaticResource RoundedTextboxStyle}" CharacterCasing="Upper" TextChanged="txtName_TextChanged"/>
                </Border>

                <TextBlock Text="Stock:" FontSize="14" Margin="0,10,0,0" />
                <Border Style="{StaticResource RoundedBorderStyle}">
                    <TextBox x:Name="txtStock" Style="{StaticResource RoundedTextboxStyle}" CharacterCasing="Upper" TextChanged="txtStock_TextChanged"/>
                </Border>

                <TextBlock Text="Warehouse:" FontSize="14" Margin="0,10,0,0" />
                <ComboBox x:Name="cmbWarehouses" FontFamily="Lexend" FontSize="14" Foreground="#474747"
                          Padding="10" Width="Auto" Height="40" Background="White" BorderBrush="#474747"
                          BorderThickness="2" HorizontalContentAlignment="Left" Margin="0,0,0,10">
                    <ComboBox.Resources>
                        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="5">
                                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#474747" Width="8" Height="8" Margin="0,5,10,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="ComboBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBox">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="5">
                                            <Grid>
                                                <ToggleButton Name="ToggleButton" Style="{StaticResource ComboBoxToggleButton}" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"/>
                                                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{Binding SelectedItem.Value, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue='Select Warehouse'}" Margin="10,0,40,0" VerticalAlignment="Center"/>
                                                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="10" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ScrollViewer>
                                                            <StackPanel>
                                                                <ItemsPresenter/>
                                                            </StackPanel>
                                                        </ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <Button x:Name="btnUpdate" Content="Update" Height="45" Background="#58D68D" Foreground="White" Margin="0,20,0,0" FontSize="16" Click="BtnUpdate_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>