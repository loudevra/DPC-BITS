<UserControl x:Class="DPC.Views.Stocks.PurchaseOrder.Delivery.NewDelivery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DPC.DPC.Views.Stocks.PurchaseOrder.Delivery"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Background="#D9D9D9" FontFamily="Lexend"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="25,20,0,10">
            <materialDesign:PackIcon Kind="TruckDelivery" Width="30" Height="30" Foreground="#474747" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Delivery Form" FontWeight="SemiBold" FontSize="25" Foreground="#474747" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernScrollViewerStyle}">
            <Grid Margin="25,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0"  Margin="0,0,15,0">
                    <TextBlock Text="Client Name:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Style="{StaticResource RoundedBorderStyle}" Background="White" Height="40" BorderBrush="#AEAEAE" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="txtClientName" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" IsReadOnly="True"/>
                            <materialDesign:PackIcon Kind="Account" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AEAEAE"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Client Details:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <Border Style="{StaticResource RoundedBorderStyle}" Background="White" BorderBrush="#AEAEAE" BorderThickness="1">
                        <TextBox x:Name="txtClientDetails" Height="120" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" Padding="10" IsReadOnly="True"/>
                    </Border>

                    <TextBlock Text="Shipping Method (Required):" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <ComboBox x:Name="cmbShippingMethod" 
                              Style="{StaticResource RoundedComboBoxStyle}" 
                              Height="40" Background="White">
                        <ComboBoxItem Content="Pick-up"/>
                        <ComboBoxItem Content="Delivery - Truck"/>
                        <ComboBoxItem Content="Delivery - Courier (Lalamove/Grab)"/>
                        <ComboBoxItem Content="Shipping (LBC/J&amp;T)"/>
                    </ComboBox>
                    <TextBlock Text="Approved By (Optional):" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <ComboBox x:Name="cmbApprovedBy" 
                              Style="{StaticResource RoundedComboBoxStyle}" 
                              Height="40" Background="White">
                        <ComboBoxItem Content="Alecksandra Balingit"/>
                        <ComboBoxItem Content="Parvit Kumar"/>
                    </ComboBox>
                    <TextBlock Text="Payment Terms (Optional):" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <ComboBox x:Name="cmbPaymentTerm" 
                              Style="{StaticResource RoundedComboBoxStyle}" 
                              Height="40" Background="White">
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="30 Days PDC"/>
                        <ComboBoxItem Content="Upon Completion"/>
                    </ComboBox>
                </StackPanel>

                <Border Grid.Column="1" Grid.Row="0" Background="White" CornerRadius="15" Padding="20" BorderBrush="#AEAEAE" BorderThickness="1" Margin="15,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Delivery Logistics" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Grid.Row="1" Text="Delivery Number:" Margin="0,0,0,5"/>
                        <Border Grid.Row="2" Style="{StaticResource RoundedBorderStyle}" Background="#F5F5F5" Height="35" Margin="0,0,0,15">
                            <TextBox x:Name="txtDeliveryNumber" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                        </Border>

                        <TextBlock Grid.Row="3" Text="Related Billing (Invoice):" Margin="0,0,0,5"/>
                        <Border Grid.Row="4" Style="{StaticResource RoundedBorderStyle}" Background="#F5F5F5" Height="35" Margin="0,0,0,15">
                            <TextBox x:Name="txtInvoiceNumber" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                        </Border>

                        <TextBlock Grid.Row="5" Text="Delivery Date:" Margin="0,0,0,5"/>
                        <Border Grid.Row="6" Style="{StaticResource RoundedBorderStyle}" BorderBrush="#AEAEAE" BorderThickness="1" Height="35" Margin="0,0,0,15">
                            <Grid>
                                <DatePicker x:Name="dtDate" 
                            Style="{StaticResource SingleDatePickerStyle}" 
                            SelectedDate="{Binding SelectedDate, Mode=TwoWay}" 
                            DisplayDateStart="{Binding MinimumDate}" 
                            SelectedDateChanged="dtDate_SelectedDateChanged"/>

                                <Button x:Name="btnOpenCalendar" Click="btnOpenCalendar_Click" Style="{StaticResource DateButtonStyle}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarText" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="txtSelectedDate" Text="{Binding ElementName=dtDate, Path=SelectedDate, StringFormat='MMM dd, yyyy'}" 
                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="7" Text="Delivery Note:" Margin="0,0,0,5"/>
                        <Border Grid.Row="8" Style="{StaticResource RoundedBorderStyle}" BorderBrush="#AEAEAE" BorderThickness="1" VerticalAlignment="Stretch">
                            <TextBox x:Name="txtDeliveryNote" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True"
                     BorderThickness="0" 
                     Background="Transparent" 
                     Padding="10" 
                     VerticalContentAlignment="Top"
                     VerticalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Width="Auto" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,15">
                    <Border Background="#1D3242" CornerRadius="10,10,0,0" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Item Name" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Qty" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Serial Number" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="MainContainer" Orientation="Vertical">
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button x:Name="btnGenerateDeliveryReceipt"
                        MinWidth="210"
                        MaxWidth="250"
                        Height="45"
                        Click="GenerateDeliveryReceipt_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="#1D5642"
                        BorderBrush="#1D5642"
                        Foreground="White"
                        materialDesign:ButtonAssist.CornerRadius="20">

                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentEditOutline" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="GovCEButton" 
                                   Text="Generate Delivery Receipts" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>