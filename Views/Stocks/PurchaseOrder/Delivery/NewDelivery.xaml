<UserControl x:Class="DPC.Views.Stocks.PurchaseOrder.Delivery.NewDelivery"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DPC.DPC.Views.Stocks.PurchaseOrder.Delivery"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Background="#D9D9D9" FontFamily="Lexend"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="25,20,0,10">
            <materialDesign:PackIcon Kind="TruckDelivery" Width="30" Height="30" Foreground="#474747" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Delivery Form" FontWeight="SemiBold" FontSize="25" Foreground="#474747" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernScrollViewerStyle}">
            <Grid Margin="25,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Client Name:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Border Style="{StaticResource RoundedBorderStyle}" Background="White" Height="40" BorderBrush="#AEAEAE" BorderThickness="1">
                        <Grid>
                            <TextBox x:Name="txtClientName" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0" IsReadOnly="True"/>
                            <materialDesign:PackIcon Kind="Account" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#AEAEAE"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Client Details:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <Border Style="{StaticResource RoundedBorderStyle}" Background="White" BorderBrush="#AEAEAE" BorderThickness="1">
                        <TextBox x:Name="txtClientDetails" Height="120" TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent" Padding="10" IsReadOnly="True"/>
                    </Border>

                    <TextBlock Text="Shipping Method:" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <ComboBox x:Name="cmbShippingMethod" 
                              Style="{StaticResource RoundedComboBoxStyle}" 
                              Height="40" Background="White">
                        <ComboBoxItem Content="Pick-up"/>
                        <ComboBoxItem Content="Delivery - Truck"/>
                        <ComboBoxItem Content="Delivery - Courier (Lalamove/Grab)"/>
                        <ComboBoxItem Content="Shipping (LBC/J&amp;T)"/>
                    </ComboBox>
                </StackPanel>

                <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20" BorderBrush="#AEAEAE" BorderThickness="1" Margin="15,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Delivery Logistics" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                        <TextBlock Text="Delivery Number:" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}" Background="#F5F5F5" Height="35" Margin="0,0,0,15">
                            <TextBox x:Name="txtDeliveryNumber" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                        </Border>

                        <TextBlock Text="Related Billing (Invoice):" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}" Background="#F5F5F5" Height="35" Margin="0,0,0,15">
                            <TextBox x:Name="txtInvoiceNumber" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="10,0"/>
                        </Border>

                        <TextBlock Text="Delivery Date:" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}" BorderBrush="#AEAEAE" BorderThickness="1" Height="35" Margin="0,0,0,15">
                            <Grid>
                                <DatePicker x:Name="calDeliveryDate" Visibility="Collapsed" SelectedDate="{Binding SelectedDate}"/>
                                <Button Style="{StaticResource DateButtonStyle}"  Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalendarText" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding SelectedDate, StringFormat='MMM dd, yyyy'}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <TextBlock Text="Delivery Note:" Margin="0,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}" BorderBrush="#AEAEAE" BorderThickness="1">
                            <TextBox x:Name="txtDeliveryNote" Height="80" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="10"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>