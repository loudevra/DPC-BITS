<UserControl x:Class="DPC.Views.Stocks.PurchaseOrder.Delivery.ManageDeliveryReceipt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="Transparent"
        Width="Auto" Height="Auto">

    <UserControl.Resources>
        <!--Add Quote Button Style-->
        <Style x:Key="AddQuoteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Border Style -->
        <Style x:Key="RoundedBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>

        <!-- Button Style -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Style="{StaticResource RoundedBorderStyle}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#AEAEAE"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Style="{StaticResource RoundedBorderStyle}" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="1">
                            <Grid>
                                <!-- Define two columns, Content on left, Arrow on right -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="35" />
                                </Grid.ColumnDefinitions>

                                <!-- Selected Item Content -->
                                <ContentPresenter Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      VerticalAlignment="Center"
                                      Margin="10,0,5,0"/>

                                <!-- Arrow Button (Right) -->
                                <ToggleButton Name="ToggleButton" 
                                  Grid.Column="1"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" BorderThickness="0">
                                                            <materialDesign:PackIcon Kind="ChevronDown" Width="20" Height="20" Foreground="#AEAEAE"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <!-- Dropdown Items -->
                                <Popup Name="Popup"
                           Placement="Bottom"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           AllowsTransparency="True"
                           Focusable="False"
                           MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <!-- MATCH WIDTH -->
                                    <Border Style="{StaticResource RoundedBorderStyle}" 
                                Background="White" 
                                BorderBrush="#AEAEAE"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <!-- MATCH WIDTH -->
                                        <ScrollViewer>
                                            <StackPanel>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedGridStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#AEAEAE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Add the RoundedTextboxStyle that was missing in the original code -->
        <Style x:Key="RoundedTextboxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Lexend"/>
        </Style>

        <!-- Convert Button Style -->
        <Style x:Key="ConvertButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- Main Content Area -->
        <Grid>
            <!-- Main Content (ScrollViewer) -->
            <ScrollViewer VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Main Content -->
                    <StackPanel Grid.Row="1" >
                        <!-- Header Section with "Quote" and "Convert to" button aligned horizontally -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Manage Delivery Receipts"
                                       FontSize="32"
                                       FontWeight="SemiBold"
                                       FontFamily="Lexend"
                                       Foreground="#555555"
                                       VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <Button x:Name="BtnAddQuote" HorizontalAlignment="Right" Style="{StaticResource AddQuoteButtonStyle}" Margin="20,0,0,0" Height="35" Width="152" Click="NavigateToNewDelivery">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="25" Height="25" Foreground="#FDFDFD"/>
                                        <TextBlock Text="Add Quote" FontSize="17" Foreground="#FDFDFD"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Filters and Controls -->
                        <Border Grid.Row="1" Padding="5" Background="White" CornerRadius="10" BorderBrush="White" Margin="0,0,0,15" >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Left Controls -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0,5,5">
                                    <!-- Excel Button -->
                                    <Button Style="{StaticResource RoundedButtonStyle}" Background="#456B2E" Foreground="White" Width="75" Height="29" Margin="10,0,0,0" Click="ExportToExcel">
                                        <materialDesign:PackIcon Kind="MicrosoftExcel" Width="25" Height="25"/>
                                    </Button>

                                    <!--Border as Straight Line-->
                                    <Border Width="1.5" Height="Auto" Background="#D9D9D9" Margin="10,5,10,5"/>

                                    <!--Combo Box-->
                                    <ComboBox x:Name="cmbLimit" Width="75" Style="{StaticResource RoundedComboBoxStyle}" Height="30">
                                        <ComboBoxItem Content="10" IsSelected="True"/>
                                        <ComboBoxItem Content="25"/>
                                        <ComboBoxItem Content="50"/>
                                        <ComboBoxItem Content="100"/>
                                    </ComboBox>

                                    <!-- Calendar Date Time -->
                                    <Border Style="{StaticResource RoundedGridStyle}" HorizontalAlignment="Right" Margin="10" MinWidth="250" Height="30">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Hidden DatePickers -->
                                            <!-- Bind SelectedDate to the viewmodel property name 'SelectedDate' (SingleCalendar) -->
                                            <DatePicker x:Name="StartDatePicker"
                                                        SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                                        Visibility="Hidden"
                                                        SelectedDateChanged="StartDatePicker_SelectedDateChanged" />

                                            <DatePicker x:Name="DueDatePicker"
                                                        SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                                        Visibility="Hidden"
                                                        SelectedDateChanged="DueDatePicker_SelectedDateChanged" />

                                            <!-- Start Date Button -->
                                            <Button x:Name="StartDateButton" Grid.Column="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    Click="StartDateButton_Click">
                                                <!-- Named TextBlock for reliable programmatic updates -->
                                                <TextBlock x:Name="StartDateText" Text="Start" 
                                                           FontFamily="Lexend"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,5,0"/>
                                            </Button>

                                            <TextBlock Text=" - "
                                                       FontFamily="Lexend"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Grid.Column="1" />

                                            <!-- End Date Button -->
                                            <Button x:Name="DueDateButton" Grid.Column="2"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    HorizontalAlignment="Stretch"
                                                    Click="DueDateButton_Click">
                                                <TextBlock x:Name="DueDateText" Text="End"
                                                           FontFamily="Lexend"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           Margin="5,0,10,0"/>
                                            </Button>

                                            <materialDesign:PackIcon Kind="Calendar"
                                                                     Width="20"
                                                                     Height="20"
                                                                     Foreground="Black"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Center"
                                                                     Grid.Column="3"
                                                                     Margin="0,0,5,0"/>

                                            <!-- Clear dates button -->
                                            <Button Grid.Column="4" x:Name="BtnClearDates" Width="26" Height="26" Margin="2,0,5,0" ToolTip="Clear dates"
                                                    Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#AEAEAE"/>
                                            </Button>
                                        </Grid>
                                    </Border>


                                    <!--View Grid Button-->
                                    <Button x:Name="btnViewGrid" Style="{StaticResource IconButton}">
                                        <materialDesign:PackIcon Kind="ViewGridOutline" Width="24" Height="24" Margin="10" Foreground="#555555"/>
                                    </Button>

                                    <!--Menu Button/Filter-->
                                    <Button x:Name="btnMenuFilter" Style="{StaticResource IconButton}">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="24" Height="24" Margin="10" Foreground="#555555"/>
                                    </Button>
                                </StackPanel>

                                <!--Right Control/s-->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!--Search Button-->
                                    <Border Style="{StaticResource RoundedGridStyle}" MinWidth="200" Width="211" Height="34">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="3*"/>
                                                <RowDefinition Height="19*"/>
                                            </Grid.RowDefinitions>
                                            <TextBox x:Name="SearchText"
                                                     BorderThickness="0" Background="Transparent" FontFamily="Lexend" Style="{StaticResource RoundedTextboxStyle}"
                                                     Height="22" VerticalAlignment="Top" HorizontalAlignment="Center" Width="179" Grid.RowSpan="2" TextChanged="SearchText_TextChanged" />
                                            <materialDesign:PackIcon Kind="Magnify" Width="25" Height="26" Foreground="#AEAEAE" Margin="159,0,0,0" VerticalAlignment="Center" Grid.RowSpan="2"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- DataGrid Section - Scrollable Content -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0">
                            <DataGrid Name="dataGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      RowBackground="White"
                                      AlternatingRowBackground="WhiteSmoke"
                                      BorderThickness="0"
                                      Height="425"
                                      FontFamily="Lexend"
                                      MouseLeftButtonUp="DataGrid_CellClick" 
                                      IsReadOnly="True">

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Margin" Value="0,5,0,5"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="Height" Value="45"/>
                                    </Style>
                                </DataGrid.RowStyle>

                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="FontFamily" Value="Lexend"/>
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#474747"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="Background" Value="White"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>

                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,5"/>
                                        <Setter Property="FontFamily" Value="Lexend"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="TextBlock.TextWrapping" Value="NoWrap"/>
                                        <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
                                    </Style>
                                </DataGrid.CellStyle>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DR Number" Binding="{Binding DRNumber}" Width="150"/>
                                    <DataGridTextColumn Header="Invoice Ref" Binding="{Binding ReferenceInvoice}" Width="130"/>
                                    <DataGridTextColumn Header="DR Date" Binding="{Binding DRDate}" Width="120"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding DeliveryStatus}" Width="140">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="FULL DELIVERY">
                                                        <Setter Property="Foreground" Value="#456B2E"/>
                                                    </Trigger>

                                                    <DataTrigger Binding="{Binding DeliveryStatus}" Value="PARTIAL DELIVERY">
                                                        <Setter Property="Foreground" Value="#FFA500"/>
                                                    </DataTrigger>

                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DeliveryStatus}" Value="PARTIAL DELIVERY"/>
                                                            <Condition Binding="{Binding IsFullyDelivered}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="#456B2E"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Client Name" Binding="{Binding ClientName}" Width="180"/>
                                    <DataGridTextColumn Header="Shipping" Binding="{Binding ShippingMethod}" Width="120"/>
                                    <DataGridTextColumn Header="Prepared By" Binding="{Binding Username}" Width="120"/>
                                    <DataGridTextColumn Header="System Date" Binding="{Binding DateAddedDisplay}" Width="120"/>

                                    <DataGridTemplateColumn Header="Actions" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Width="30" Height="30" 
                                                            Background="Transparent" 
                                                            ToolTip="Continue Partial Delivery" 
                                                            Click="OpenContinueDeliveryReceipt" 
                                                            BorderThickness="0">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding DeliveryStatus}" Value="PARTIAL DELIVERY"/>
                                                                            <Condition Binding="{Binding IsFullyDelivered}" Value="False"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <materialDesign:PackIcon Kind="ProgressCheck" Foreground="#52C69D"/>
                                                    </Button>
                                                    <Button Width="30" Height="30" Background="Transparent" ToolTip="Edit" Click="OpenEditDeliveryReceipt" BorderThickness="0">
                                                        <materialDesign:PackIcon Kind="SquareEditOutline" Foreground="#52C69D"/>
                                                    </Button>
                                                    <Button Width="30" Height="30" Background="Transparent" ToolTip="Delete" Click="DeleteDeliveryReceipt" BorderThickness="0">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#E65E5E"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ScrollViewer>

                        <!-- Table and Controls -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15"/>
                    </StackPanel>

                    <Popup x:Name="CellValuePopup"
                           Placement="Mouse"
                           AllowsTransparency="True"
                           StaysOpen="False">
                        <Border Background="White" 
                                BorderBrush="Black" 
                                BorderThickness="1" 
                                Padding="10"
                                CornerRadius="8"
                                Effect="{DynamicResource MaterialDesignShadowDepth2}">
                            <TextBlock x:Name="PopupText" 
                                       FontFamily="Lexend"
                                       FontSize="14"
                                       Foreground="Black"
                                       TextWrapping="Wrap"
                                       MaxWidth="300"/>
                        </Border>
                    </Popup>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>