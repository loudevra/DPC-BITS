<UserControl x:Class="DPC.Views.Stocks.PurchaseOrder.Delivery.PreviewEditableDeliveryReceipt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DPC.DPC.Views.Stocks.PurchaseOrder.Delivery"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Background="#D9D9D9" FontFamily="Lexend">

    <UserControl.Resources>
        <Style x:Key="RoundedBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>

        <Style x:Key="RoundedGridStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#AEAEAE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="RoundedTextboxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Lexend"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Viewbox Grid.Row="1" Margin="20">
                    <StackPanel>
                        <StackPanel x:Name="BackBtn" MouseLeftButtonUp="BackToUI_Click" Cursor="Hand" Orientation="Horizontal" Margin="0,10">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="15" Height="20" Foreground="#555555" Margin="0,0,10,0"/>
                            <TextBlock Text="Delivery Management" FontWeight="SemiBold" FontFamily="Lexend" FontSize="16" Foreground="#555555" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
                            <Button x:Name="btnPrevPage" Click="PreviousPage_Click" Content="◄ Previous" Width="100" Margin="5"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="20"
                                    Foreground="#555555" BorderBrush="#AEAEAE" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock x:Name="txtPageInfo" Text="Page 1 of 1" VerticalAlignment="Center" Margin="20,0"
                                       FontFamily="Lexend" FontSize="14" FontWeight="SemiBold" Foreground="#2E466B"/>
                            <Button x:Name="btnNextPage" Click="NextPage_Click" Content="Next ►" Width="100" Margin="5"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="20"
                                    Foreground="#555555" BorderBrush="#AEAEAE" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>

                        <Border Height="1344" Width="816" Background="White" CornerRadius="10" Padding="40">
                            <Grid>
                                <Grid.Background>
                                    <ImageBrush ImageSource="/Assets/images/DREAMPCBUILD LOGO WATERMARK SLANTED SPACED.png" Stretch="UniformToFill" Opacity="0.05"/>
                                </Grid.Background>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,10,0,17">
                                    <Image Source="/Assets/images/logosidebarBlack.png" Stretch="Fill" Width="234" Height="75"/>
                                </StackPanel>
                                <TextBlock x:Name="PageIndicatorText" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                           FontFamily="Lexend" FontSize="10" FontWeight="SemiBold" Foreground="#555555" Text="Page 1 of 1"/>

                                <TextBlock Grid.Row="1" Text="DELIVERY RECEIPT" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Lexend" FontSize="20" Margin="0,0,0,15"/>

                                <Grid Grid.Row="2" Margin="5,0,5,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DELIVER TO:" FontWeight="Bold" FontSize="10" Foreground="#555555" Margin="0,0,0,5"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="CLIENT NAME/COMPANY NAME: " FontWeight="Bold" FontSize="11" FontFamily="Lexend"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtDeliveryClientName" Text="ANGONO MINICIPALITY" FontSize="11" FontFamily="Lexend" TextWrapping="Wrap" Margin="5,0"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CLIENT ADDRESS: " FontWeight="Bold" FontSize="11" FontFamily="Lexend" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtDeliveryAddress" Text="Address details go here..." FontSize="11" FontFamily="Lexend" TextWrapping="Wrap" Margin="5,5,5,0"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="CONTACT NUMBER: " FontWeight="Bold" FontSize="11" FontFamily="Lexend" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtDeliveryContact" Text="09XXXXXXXXX" FontSize="11" FontFamily="Lexend" Margin="5,5,5,0"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="COMPANY REPRESENTATIVE: " FontWeight="Bold" FontSize="11" FontFamily="Lexend" Margin="0,5,0,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtDeliveryRep" Text="ANGONO MINICIPALITY" FontSize="11" FontFamily="Lexend" Margin="5,5,5,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="DOCUMENT DETAILS:" FontWeight="Bold" FontSize="10" Foreground="#555555" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="DR #:" FontWeight="SemiBold" FontSize="11" Width="70"/>
                                            <Border BorderBrush="Black" BorderThickness="0.5" Width="170" Padding="5,0">
                                                <TextBlock x:Name="txtDeliveryNumber" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Date:" FontWeight="SemiBold" FontSize="11" Width="70"/>
                                            <Border BorderBrush="Black" BorderThickness="0.5"  Width="170" Padding="5,0">
                                                <TextBlock x:Name="txtDeliveryDate" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Ref Inv:" FontWeight="SemiBold" FontSize="11" Width="70"/>
                                            <Border BorderBrush="Black" BorderThickness="0.5"  Width="170" Padding="5,0">
                                                <TextBlock x:Name="txtReferenceInvoice" FontSize="11" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="NOT VALID WITHOUT DREAM PC VERIFIED STAMP" FontWeight="Bold" FontSize="10" Foreground="Red" Margin="0,0,0,5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1,1,1,0" Margin="5,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Border Grid.Row="0" Grid.Column="0" Background="Black" BorderBrush="Black" BorderThickness="0,0,1,0">
                                            <TextBlock Text="Sales Representative" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="Black" BorderBrush="Black" BorderThickness="0,0,1,0">
                                            <TextBlock Text="Shipping Method" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="2" Background="Black" BorderBrush="Black" BorderThickness="0,0,1,0">
                                            <TextBlock Text="Approved By" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="3" Background="Black">
                                            <TextBlock Text="Payment Terms" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <Border Grid.Row="1" Grid.Column="0" Padding="5" BorderBrush="Black" BorderThickness="0,0,1,0">
                                            <TextBlock x:Name="txtSalesRep" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Padding="5" BorderBrush="Black" BorderThickness="0,0,1,0">
                                            <TextBlock x:Name="txtShippingMethod" FontSize="10" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="2" Padding="2" BorderBrush="Black" BorderThickness="0,0,1,0">
                                            <ComboBox x:Name="cmbApproved" FontSize="10" BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                                                <ComboBoxItem Content="Alecksandra Balingit"/>
                                                <ComboBoxItem Content="Parvit Kumar"/>
                                            </ComboBox>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="3" Padding="2">
                                            <ComboBox x:Name="cmbTerms" FontSize="10" BorderThickness="0" Background="Transparent" VerticalAlignment="Center">
                                                <ComboBoxItem Content="Cash"/>
                                                <ComboBoxItem Content="30 Days PDC"/>
                                                <ComboBoxItem Content="Upon Completion"/>
                                            </ComboBox>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="4" BorderBrush="Black" BorderThickness="1" Margin="5,0,5,0">
                                    <DataGrid x:Name="DeliveryDataGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="None" Background="Transparent" BorderThickness="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="Description" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="5">
                                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ProductDescription}" FontSize="10" TextWrapping="Wrap" Opacity="0.8"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/>
                                        </DataGrid.Columns>
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="Black"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                <Setter Property="Height" Value="25"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                    </DataGrid>
                                </Border>

                                <Grid Grid.Row="5" Margin="5,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1,0,1,1" Padding="10">
                                        <TextBlock Text="CLIENT NAME AND SIGNATURE" 
                                                    FontWeight="Bold" 
                                                    FontSize="12" 
                                                    TextWrapping="Wrap" 
                                                    VerticalAlignment="Center" 
                                                    HorizontalAlignment="Center" 
                                                    TextAlignment="Center"/>
                                    </Border>

                                    <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10,5,10,5">
                                        <StackPanel VerticalAlignment="Bottom">
                                            <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="0,0,0,5" Width="200" HorizontalAlignment="Center"/>
                                            <TextBlock Text="By signing this document, you acknowledge that all delivered items are in good condition and complete." 
                                                       FontStyle="Italic" 
                                                       FontSize="7" 
                                                       Foreground="Red" 
                                                       TextWrapping="Wrap" 
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="15,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                                                <TextBlock Text="PULL OUT FORM NUMBER:" 
                                                           FontWeight="Bold" 
                                                           FontStyle="Italic" 
                                                           FontSize="10" 
                                                           VerticalAlignment="Bottom"/>
                                                <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="5,0,0,0" Width="180"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="RECEIVED BY:" 
                                                           FontWeight="Bold" 
                                                           FontStyle="Italic" 
                                                           FontSize="10" 
                                                           VerticalAlignment="Bottom"/>
                                                <Border BorderBrush="Black" BorderThickness="0,0,0,1" Margin="5,0,0,0" Width="240"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="Black" BorderThickness="1,0,1,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Text="Note: " FontSize="10" FontWeight="Bold" BorderThickness="0"/>
                                            <TextBox Grid.Column="1" x:Name="txtNotes" FontSize="10" BorderThickness="0" />
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="Black" BorderThickness="1,0,1,1">
                                        <TextBox Text="Placeholder" FontSize="10" HorizontalAlignment="Center" BorderThickness="0" Foreground="Gray"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.ColumnSpan="3" Padding="0,10,0,0" BorderBrush="Black" BorderThickness="1,0,1,1">
                                        <StackPanel >
                                            <TextBlock Text="Dream PC Build and IT Solutions Inc." HorizontalAlignment="Center" FontWeight="Bold" FontSize="10"/>
                                            <TextBlock Text="Unit 2A &amp; 2B LEGENDA BUILDING CIRCUMFERENCIAL RD. | ANTIPOLO CITY, RIZAL 1870 | PHONE: +639171873722 | TEL: 02-8801-4252 | EMAIL: information@dreampcbuild.com" HorizontalAlignment="Center" FontSize="8" Margin="0,0,0,10"/>
                                            <TextBlock Text="MAKE ALL CHECKS PAYABLE TO DREAM PC BUILD AND IT SOLUTIONS INC" FontWeight="Bold" Margin="0,3,0,0" TextAlignment="Center" FontFamily="Lexend" FontSize="11" Foreground="#090909"/>
                                            <TextBlock Text="Thank you for your business!" TextAlignment="Center" FontFamily="Lexend" FontSize="8" Foreground="#090909"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Viewbox>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>