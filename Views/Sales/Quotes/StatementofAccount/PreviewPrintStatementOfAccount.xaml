<UserControl x:Class="DPC.Views.SOA.PreviewPrintStatementOfAccount"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Background="#E4E4E4" FontFamily="Lexend"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="BlackGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch">

            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,20,10,40">
                <StackPanel>

                    <DockPanel LastChildFill="False" Margin="0,0,0,15">

                       

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                            <Button Click="CancelButton" Content="Cancel" Margin="0,0,5,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="20"
                                    Foreground="#AEAEAE" BorderBrush="#AEAEAE" FontWeight="SemiBold" FontSize="14" Width="90" Height="36"/>

                            <Button x:Name="SaveDb" Click="SaveDb_Click" Content="Save" Margin="0,0,5,0"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="20"
                                    Foreground="White" FontWeight="SemiBold" FontSize="14" Width="80" Height="36" Background="#2E466B"/>

                            <Button Click="SavePrint" Content="Print"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="20"
                                    Foreground="White" FontWeight="SemiBold" FontSize="14" Width="90" Height="36" Background="#2E466B"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <Button x:Name="btnPrevPage" Click="PreviousPage_Click" Content="&#171; Previous" Width="100" Margin="5"
                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="15"
                                Foreground="#555555" BorderBrush="#AEAEAE" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock x:Name="txtPageInfo" Text="Page 1 of 1" VerticalAlignment="Center" Margin="20,0"
                                   FontFamily="Lexend" FontSize="14" FontWeight="Bold" Foreground="#1D3242"/>
                        <Button x:Name="btnNextPage" Click="NextPage_Click" Content="Next &#187;" Width="100" Margin="5"
                                Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="15"
                                Foreground="#555555" BorderBrush="#AEAEAE" FontWeight="SemiBold" FontSize="12"/>
                    </StackPanel>

                    <Border x:Name="PrintAreaBorder" Height="Auto" MinHeight="1344" Width="816" Background="White" CornerRadius="5" Padding="40" VerticalAlignment="Top" HorizontalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="15" ShadowDepth="5"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.Background>
                                <ImageBrush ImageSource="/Assets/images/DREAMPCBUILD LOGO WATERMARK SLANTED SPACED.png" Stretch="UniformToFill" Opacity="0.05"/>
                            </Grid.Background>

                            <StackPanel>
                                <Grid Margin="0,0,0,30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image x:Name="LogoImage" Source="/Assets/images/logo.png" Width="60" Height="60" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="Source" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>


                                        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,10,0,17">
                                            <Image Source="/Assets/images/logosidebarBlack.png" Stretch="Fill" Width="234" Height="75"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock x:Name="PageIndicatorText" Grid.Column="1" Text="Page 1 of 1" Foreground="#666666" VerticalAlignment="Top" FontSize="11" FontFamily="Arial"/>
                                </Grid>

                                <TextBlock Text="STATEMENT OF ACCOUNT" FontSize="22" FontWeight="Bold" FontFamily="Arial" HorizontalAlignment="Center" Margin="0,0,0,30" Foreground="Black"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Client Name/Company:" FontSize="11" Margin="0,0,0,3" Foreground="Black" FontFamily="Arial" FontWeight="Bold"/>
                                        <TextBlock Text="Client Details:" FontSize="11" Margin="0,0,0,3" Foreground="Black" FontFamily="Arial" FontWeight="Bold"/>
                                        <TextBlock Text="Project Title:" FontSize="11" Margin="0,15,0,3" Foreground="Black" FontFamily="Arial" FontWeight="Bold"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="5,0,20,0">
                                        <TextBlock Text="{Binding ClientName}" FontSize="11" Margin="0,0,0,3" Foreground="Black" TextWrapping="Wrap" FontFamily="Arial"/>
                                        <TextBlock Text="{Binding ClientDetails}" FontSize="11" Margin="0,0,0,3" Foreground="Black" TextWrapping="Wrap" FontFamily="Arial"/>
                                        <TextBlock Text="{Binding ProjectTitle}" FontSize="11" Margin="0,15,0,3" Foreground="Black" TextWrapping="Wrap" FontFamily="Arial"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,10,0">
                                        <TextBlock Text="SOA No:" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Height="22" Foreground="Black" FontFamily="Arial"/>
                                        <TextBlock Text="Date:" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Height="22" Foreground="Black" FontFamily="Arial"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <Border BorderBrush="Black" BorderThickness="1,1,1,0" Height="22">
                                            <TextBlock Text="{Binding SOANo}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" FontFamily="Arial"/>
                                        </Border>
                                        <Border BorderBrush="Black" BorderThickness="1" Height="22">
                                            <TextBlock Text="{Binding StatementDate}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" FontFamily="Arial"/>
                                        </Border>
                                        <TextBlock Text="NOT VALID WITHOUT DREAM PC VERIFIED STAMP" Foreground="Red" FontSize="8" FontWeight="Bold" FontFamily="Arial" Width="168" Height="15"/>
                                    </StackPanel>
                                </Grid>

                                <Border BorderThickness="1" BorderBrush="Black" Background="Transparent">
                                    <StackPanel>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Background="Black">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="PO No. / SI No:" Foreground="White" FontWeight="Bold" FontSize="10" Padding="10,5" FontFamily="Arial" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="DR No. / BS No:" Foreground="White" FontWeight="Bold" FontSize="10" Padding="10,5" FontFamily="Arial" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="Delivery &amp; Contract Information:" Foreground="White" FontWeight="Bold" FontSize="10" Padding="10,5" FontFamily="Arial" HorizontalAlignment="Center"/>
                                            </Grid>
                                            <Grid Grid.Row="1" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10,5">
                                                    <TextBlock FontSize="10" Foreground="Black" FontFamily="Arial" HorizontalAlignment="Center">
                                                        <Run Text="{Binding PONo}"/> <Run Text=" / "/> <Run Text="{Binding SINo}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10,5">
                                                    <TextBlock FontSize="10" Foreground="Black" FontFamily="Arial" HorizontalAlignment="Center">
                                                        <Run Text="{Binding DRNo}"/> <Run Text=" / "/> <Run Text="{Binding BSNo}"/>
                                                    </TextBlock>
                                                </Border>
                                                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="10,5">
                                                    <TextBlock FontSize="10" Foreground="Black" FontFamily="Arial" HorizontalAlignment="Center">
                                                        <Run Text="PO Date: "/><Run Text="{Binding PODate}"/><Run Text="  |  Period: "/><Run Text="{Binding DeliveryPeriod}"/><Run Text=" Days"/>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Grid>

                                        <DataGrid x:Name="dgSOAItems" ItemsSource="{Binding LineItems}" AutoGenerateColumns="False" HeadersVisibility="Column" 
                                                  CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                                                  ColumnHeaderStyle="{StaticResource BlackGridHeaderStyle}" GridLinesVisibility="All" HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" FontFamily="Arial">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn x:Name="ColImage" Header="Image" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Image Source="{Binding ImagePath}" Width="40" Height="40" Margin="5"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Date" Binding="{Binding DateStr}" Width="70">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                            <Setter Property="Margin" Value="10,0"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="40">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='₱ {0}'}" Width="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Payment" Binding="{Binding Payment, StringFormat='₱ {0}'}" Width="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Balance" Binding="{Binding Balance, StringFormat='₱ {0}'}" Width="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                                            <Setter Property="FontSize" Value="10"/>
                                                            <Setter Property="Margin" Value="0,0,10,0"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Margin="10,10,10,15">
                                            <TextBlock Text="SUBTOTAL (VAT Inclusive) ₱" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="0,0,100,0" Foreground="Black" FontFamily="Arial"/>
                                            <TextBlock Text="{Binding Subtotal}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" Margin="0,0,10,0" Foreground="Black" FontFamily="Arial"/>
                                        </Grid>

                                        <Border Background="Black" Padding="5" BorderThickness="0,1,0,0" BorderBrush="Black">
                                            <TextBlock Text="Payment Details &amp; Liquidated Damages" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" FontFamily="Arial"/>
                                        </Border>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="1"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>

                                            <DataGrid Grid.Column="0" x:Name="dgPaymentDetails" ItemsSource="{Binding PaymentItems}" AutoGenerateColumns="False" HeadersVisibility="Column" 
                                                      CanUserAddRows="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                                                      GridLinesVisibility="All" HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" FontFamily="Arial">
                                                <DataGrid.ColumnHeaderStyle>
                                                    <Style TargetType="DataGridColumnHeader">
                                                        <Setter Property="Background" Value="#E6E6E6"/>
                                                        <Setter Property="Foreground" Value="Black"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="FontSize" Value="10"/>
                                                        <Setter Property="Padding" Value="5"/>
                                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                        <Setter Property="BorderBrush" Value="Black"/>
                                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGrid.ColumnHeaderStyle>
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Date" Binding="{Binding DateStr}" Width="100">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="10"/>
                                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="*">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontSize" Value="10"/>
                                                                <Setter Property="Margin" Value="10,0,0,0"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="Amount Paid" Binding="{Binding AmountPaid, StringFormat='₱ {0}'}" Width="100">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter Property="FontSize" Value="10"/>
                                                                <Setter Property="Margin" Value="0,0,10,0"/>
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <Rectangle Grid.Column="1" Fill="Black"/>

                                            <StackPanel Grid.Column="2" Margin="15,10,15,10">
                                                <TextBlock Text="Liquidated Damages (LD) Computation:" FontWeight="Bold" FontSize="10" Margin="0,0,0,5" Foreground="Black" FontFamily="Arial"/>
                                                <TextBlock Text="Basis: 0.1% of total contract price per day of delay" FontSize="10" Margin="0,0,0,5" Foreground="Black" FontFamily="Arial"/>
                                                <Grid Margin="10,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Contract Amount:" FontSize="10" Margin="0,2" Foreground="Black" FontFamily="Arial"/>
                                                        <TextBlock Text="LD Rate / Day:" FontSize="10" Margin="0,2" Foreground="Black" FontFamily="Arial"/>
                                                        <TextBlock Text="No. of Days Delayed:" FontSize="10" Margin="0,2" Foreground="Black" FontFamily="Arial"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding ContractAmount, StringFormat='₱ {0}'}" FontSize="10" Margin="0,2" Foreground="Black" FontFamily="Arial"/>
                                                        <TextBlock FontSize="10" Margin="0,2" Foreground="Black" FontFamily="Arial">
                                                            <Run Text="{Binding LDRate}"/> <Run Text="% (₱ "/> <Run Text="{Binding LDPerDay}"/> <Run Text=")"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding LDDaysDelayed}" FontSize="10" Margin="0,2" Foreground="Black" FontFamily="Arial"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>

                                        <Border BorderBrush="Black" BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="1"/>
                                                    <ColumnDefinition Width="300"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Padding="20">
                                                    <TextBlock Text="PRINTED NAME AND SIGNATURE" FontWeight="Bold" FontSize="10" FontFamily="Arial" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="Black"/>
                                                </Border>

                                                <Rectangle Grid.Column="1" Fill="Black"/>

                                                <StackPanel Grid.Column="2">
                                                    <Grid Margin="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10,4">
                                                            <TextBlock Text="SUBTOTAL" FontSize="10" FontWeight="Bold" Foreground="Black" FontFamily="Arial"/>
                                                        </Border>
                                                        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="10,4">
                                                            <TextBlock Text="{Binding Subtotal, StringFormat='₱ {0}'}" FontSize="10" HorizontalAlignment="Right" Foreground="Black" FontFamily="Arial"/>
                                                        </Border>

                                                        <Border Grid.Column="0" Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10,4" Margin="0,23,0,0">
                                                            <TextBlock Text="TOTAL PAYMENT MADE" FontSize="10" FontWeight="Bold" Foreground="Black" FontFamily="Arial"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="10,4" Margin="0,23,0,0">
                                                            <TextBlock Text="{Binding TotalPayment, StringFormat='₱ {0}'}" FontSize="10" HorizontalAlignment="Right" Foreground="Black" FontFamily="Arial"/>
                                                        </Border>

                                                        <Border Grid.Column="0" Grid.Row="2" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10,4" Margin="0,46,0,0">
                                                            <TextBlock Text="OUTSTANDING BALANCE" FontSize="10" FontWeight="Bold" Foreground="Black" FontFamily="Arial"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Grid.Row="2" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="10,4" Margin="0,46,0,0">
                                                            <TextBlock Text="{Binding OutstandingBalance, StringFormat='₱ {0}'}" FontSize="10" HorizontalAlignment="Right" Foreground="Black" FontFamily="Arial"/>
                                                        </Border>

                                                        <Border Grid.Column="0" Grid.Row="3" BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10,4" Margin="0,69,0,0">
                                                            <TextBlock Text="LIQUIDATED DAMAGES" FontSize="10" FontWeight="Bold" Foreground="Black" FontFamily="Arial"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Grid.Row="3" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="10,4" Margin="0,69,0,0">
                                                            <TextBlock Text="{Binding LiquidatedDamages, StringFormat='₱ {0}'}" FontSize="10" HorizontalAlignment="Right" Foreground="Black" FontFamily="Arial"/>
                                                        </Border>

                                                        <Border Grid.Column="0" Grid.Row="4" BorderBrush="Black" BorderThickness="0,0,1,0" Padding="10,5" Margin="0,92,0,0">
                                                            <TextBlock Text="NET AMOUNT DUE" FontSize="11" FontWeight="Bold" Foreground="Red" FontFamily="Arial"/>
                                                        </Border>
                                                        <Border Grid.Column="1" Grid.Row="4" BorderBrush="Black" BorderThickness="0,0,0,0" Padding="10,5" Margin="0,92,0,0">
                                                            <TextBlock Text="{Binding NetAmountDue, StringFormat='₱ {0}'}" FontSize="11" FontWeight="Bold" Foreground="Red" HorizontalAlignment="Right" FontFamily="Arial"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5,5,5,20">
                                            <TextBlock Text="Notes:" FontWeight="Bold" FontSize="10" FontFamily="Arial" Foreground="Black"/>
                                        </Border>
                                        <Border BorderBrush="Black" BorderThickness="0,1,0,0" Padding="5,5,5,20">
                                            <TextBlock Text="Remarks:" FontWeight="Bold" FontSize="10" FontFamily="Arial" Foreground="Black"/>
                                        </Border>

                                        <Border BorderBrush="Black" BorderThickness="0,1,0,1" Background="#F0F0F0" Padding="2">
                                            <TextBlock Text="TERMS" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center" FontFamily="Arial" Foreground="Black"/>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="10,5">
                                                <TextBlock Text="For CASH payments:" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center" Margin="0,0,0,2" Foreground="Black" FontFamily="Arial"/>
                                                <TextBlock Text="50% upon ordering" FontSize="8" HorizontalAlignment="Center" Foreground="Black" FontFamily="Arial"/>
                                                <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,2"/>
                                                <TextBlock Text="30% upon delivery" FontSize="8" HorizontalAlignment="Center" Foreground="Black" FontFamily="Arial"/>
                                                <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,2"/>
                                                <TextBlock Text="20% upon completion" FontSize="8" HorizontalAlignment="Center" Foreground="Black" FontFamily="Arial"/>
                                                <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,2"/>
                                                <TextBlock Text="Progress billing remaining balance (for bulk orders)" FontSize="8" HorizontalAlignment="Center" Foreground="Black" FontFamily="Arial"/>
                                            </StackPanel>

                                            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1,0,1,0">
                                                <StackPanel Margin="10,5">
                                                    <TextBlock Text="For CHEQUES payment:" FontWeight="Bold" FontSize="8" HorizontalAlignment="Center" Margin="0,0,0,2" Foreground="Black" FontFamily="Arial"/>
                                                    <TextBlock Text="Order will process upon clearance of cheque" FontSize="8" HorizontalAlignment="Center" Foreground="Black" FontFamily="Arial"/>
                                                    <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,2"/>
                                                    <TextBlock Text="Any additional orders will be charged separately" FontSize="8" HorizontalAlignment="Center" Foreground="Black" FontFamily="Arial"/>
                                                    <Border BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Margin="0,2"/>
