<UserControl x:Class="DPC.Views.HRM.Employees.Employees.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F5F5F5">

    <UserControl.Resources>

        <!-- =========================
             GENERAL BUTTON STYLES
        ========================== -->
        <Style x:Key="AddNewButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="145"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#E9E9E9"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#5C5C5C"/>
            <Setter Property="Foreground" Value="#474747"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="19"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="16"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================
             COMBOBOX
        ========================== -->
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="Foreground" Value="#474747"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border CornerRadius="17"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,5,0"/>

                                <ToggleButton Grid.Column="1"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" BorderThickness="0">
                                                            <materialDesign:PackIcon Kind="ChevronDown"
                                                                                     Width="20"
                                                                                     Height="20"
                                                                                     Foreground="#474747"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <Popup Placement="Bottom"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade"
                                       MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Margin="0,6,0,0"
                                            CornerRadius="12"
                                            Background="White"
                                            BorderBrush="#D9D9D9"
                                            BorderThickness="1"
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer MaxHeight="220">
                                            <StackPanel>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================
             INPUT / CARDS
        ========================== -->
        <Style x:Key="ModernCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="RoundedTextboxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#474747"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernSearchBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="19"/>
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>

        <!-- =========================
             DATAGRID
        ========================== -->
        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="Foreground" Value="#474747"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style x:Key="ModernColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4B4B4B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SeparatorBrush" Value="Transparent"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <Style x:Key="ModernRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </SelectiveScrollingGrid.RowDefinitions>

                                <DataGridCellsPresenter Grid.Column="1"/>
                                <DataGridDetailsPresenter Grid.Column="1"
                                                          Grid.Row="1"
                                                          Visibility="{TemplateBinding DetailsVisibility}"/>
                                <DataGridRowHeader Grid.RowSpan="2"
                                                   Visibility="Collapsed"/>
                            </SelectiveScrollingGrid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7F9FC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EEF4FF"/>
                                <Setter Property="BorderBrush" Value="#D6E4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =========================
             PAGINATION BUTTONS
        ========================== -->
        <Style x:Key="PagerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#474747"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Margin="12">

                    <!-- HEADER -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,18">
                        <TextBlock Text="Employee"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   FontFamily="Lexend"
                                   Foreground="#474747"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="BtnEmployee"
                                Style="{StaticResource AddNewButtonStyle}"
                                Margin="18,0,0,0"
                                Click="AddEmployee">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus"
                                                         Width="22"
                                                         Height="22"
                                                         Foreground="#474747"
                                                         Margin="0,0,6,0"/>
                                <TextBlock Text="Employee"
                                           FontSize="16"
                                           Foreground="#474747"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- TOOLBAR -->
                    <Border Grid.Row="1"
                            Style="{StaticResource ModernCardBorderStyle}"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource RoundedButtonStyle}"
                                        Background="#4D7C38"
                                        Foreground="White"
                                        Width="78"
                                        Height="32"
                                        Margin="0,0,14,0"
                                        Click="ExportToExcel">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel"
                                                             Width="22"
                                                             Height="22"/>
                                </Button>

                                <TextBlock Text="Show"
                                           FontSize="14"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Lexend"
                                           Foreground="#474747"/>

                                <ComboBox x:Name="ComboPageSize"
                                          Width="78"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          SelectionChanged="ComboPageSize_SelectionChanged">
                                    <ComboBoxItem Content="10" IsSelected="True"/>
                                    <ComboBoxItem Content="25"/>
                                    <ComboBoxItem Content="50"/>
                                    <ComboBoxItem Content="100"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Border Style="{StaticResource ModernSearchBorderStyle}"
                                        Width="220">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Name="txtSearch"
                                                 Style="{StaticResource RoundedTextboxStyle}"
                                                 TextChanged="TxtSearch_TextChanged"/>

                                        <materialDesign:PackIcon Grid.Column="1"
                                                                 Kind="Magnify"
                                                                 Width="22"
                                                                 Height="22"
                                                                 Foreground="#1F1F1F"
                                                                 VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TABLE CARD -->
                    <Border Background="White"
                            CornerRadius="16"
                            Padding="16">
                        <StackPanel>

                            <DataGrid x:Name="EmployeesDataGrid"
                                      Style="{StaticResource ModernDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource ModernColumnHeaderStyle}"
                                      RowStyle="{StaticResource ModernRowStyle}"
                                      CellStyle="{StaticResource ModernCellStyle}"
                                      PreviewMouseWheel="DataGrid_PreviewMouseWheel">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding EmployeeID}"
                                                        Width="80"/>

                                    <DataGridTemplateColumn Header="Name"
                                                            Width="240">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Ellipse Width="30"
                                                             Height="30"
                                                             Fill="#8F8F8F"
                                                             Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Role"
                                                        Binding="{Binding RoleName}"
                                                        Width="180"/>

                                    <DataGridTextColumn Header="Department"
                                                        Binding="{Binding Department}"
                                                        Width="180"/>

                                    <DataGridTextColumn Header="Location"
                                                        Binding="{Binding LocationName}"
                                                        Width="180"/>

                                    <DataGridTemplateColumn Header="Status"
                                                            Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#EAF7EE"
                                                        CornerRadius="12"
                                                        Padding="10,4"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Status}"
                                                               Foreground="#2E7D32"
                                                               FontWeight="SemiBold"
                                                               FontSize="12"
                                                               FontFamily="Lexend"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Actions"
                                                            Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">

                                                    <Button Click="ViewEmployee"
                                                            Margin="3,0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand">
                                                        <Border Background="#EBF5FB"
                                                                CornerRadius="8"
                                                                Padding="7">
                                                            <materialDesign:PackIcon Kind="Eye"
                                                                                     Width="16"
                                                                                     Height="16"
                                                                                     Foreground="#2196F3"/>
                                                        </Border>
                                                    </Button>

                                                    <Button Click="EditEmployee_Click"
                                                            Margin="3,0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand">
                                                        <Border Background="#EAFAF1"
                                                                CornerRadius="8"
                                                                Padding="7">
                                                            <materialDesign:PackIcon Kind="PencilOutline"
                                                                                     Width="16"
                                                                                     Height="16"
                                                                                     Foreground="#4CAF50"/>
                                                        </Border>
                                                    </Button>

                                                    <Button Click="DeleteEmployee_Click"
                                                            Margin="3,0"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand">
                                                        <Border Background="#FDEDEC"
                                                                CornerRadius="8"
                                                                Padding="7">
                                                            <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                                     Width="16"
                                                                                     Height="16"
                                                                                     Foreground="#F44336"/>
                                                        </Border>
                                                    </Button>

                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- PAGINATION -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,16,0,0">
                                <Button Content="«"
                                        x:Name="BtnFirstPage"
                                        Click="BtnFirstPage_Click"
                                        Style="{StaticResource PagerButtonStyle}"/>

                                <Button Content="‹"
                                        x:Name="BtnPrevPage"
                                        Click="BtnPrevPage_Click"
                                        Margin="6,0"
                                        Style="{StaticResource PagerButtonStyle}"/>

                                <TextBlock x:Name="TxtPageNumber"
                                           Text="Page 1 of 10"
                                           VerticalAlignment="Center"
                                           FontFamily="Lexend"
                                           Foreground="#474747"
                                           Margin="4,0"/>

                                <Button Content="›"
                                        x:Name="BtnNextPage"
                                        Click="BtnNextPage_Click"
                                        Margin="6,0"
                                        Style="{StaticResource PagerButtonStyle}"/>

                                <Button Content="»"
                                        x:Name="BtnLastPage"
                                        Click="BtnLastPage_Click"
                                        Style="{StaticResource PagerButtonStyle}"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>