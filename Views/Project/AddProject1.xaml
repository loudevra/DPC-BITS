<!-- AddProject1.xaml (FULL FILE, UPDATED)
     - Removes the Assign-to dropdown
     - Displays FULL logged-in name in a read-only TextBox
-->
<UserControl x:Class="DPC.Views.Project.AddProject1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FontFamily="{StaticResource Lexend}"
             Background="#D9D9D9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#D9D9D9" Padding="20,10" Panel.ZIndex="10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="FilePlusOutline" Width="40" Height="40" Margin="0,0,15,0" Foreground="#474747" />
                <TextBlock Text="Add Project" FontSize="35" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Lexend" Foreground="#474747" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      PanningMode="Both">

            <StackPanel Width="800" Margin="40" HorizontalAlignment="Center">

                <TextBlock Text="Project Name:" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="#474747"/>
                <Border Style="{StaticResource RoundedBorderStyle}">
                    <TextBox x:Name="txtName"
                             Height="40"
                             Style="{StaticResource RoundedTextboxStyle}"
                             HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="TxtToUpper_TextChanged"/>
                </Border>

                <TextBlock Text="Status:" Margin="0,20,0,10" FontWeight="SemiBold" Foreground="#474747"/>
                <Border Style="{StaticResource RoundedBorderStyle}">
                    <ComboBox x:Name="cmbStatus"
                              Style="{StaticResource RoundedComboBoxStyle}"
                              HorizontalAlignment="Stretch"
                              Height="40"
                              SelectedIndex="0"
                              Background="Transparent"
                              BorderThickness="0">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="10" Height="10"
                                             Fill="{Binding Color}"
                                             Margin="4,0,10,0"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}"
                                               FontFamily="Lexend"
                                               FontSize="13"
                                               Foreground="#474747"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Border>

                <TextBlock Text="Customer:" Margin="0,20,0,10" FontWeight="SemiBold" Foreground="#474747"/>
                <Border Style="{StaticResource RoundedBorderStyle}">
                    <TextBox x:Name="txtCustomer"
                             Height="40"
                             Style="{StaticResource RoundedTextboxStyle}"
                             HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="TxtToUpper_TextChanged"/>
                </Border>

                <TextBlock Text="ABC:" Margin="0,20,0,10" FontWeight="SemiBold" Foreground="#474747"/>
                <Border Style="{StaticResource RoundedBorderStyle}">
                    <TextBox x:Name="txtBudget"
                             Height="40"
                             Style="{StaticResource RoundedTextboxStyle}"
                             HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             TextChanged="txtBudget_TextChanged"/>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Start Date:" Grid.Column="0" Grid.Row="0" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="#474747"/>
                    <Border Style="{StaticResource RoundedBorderStyle}" Grid.Column="0" Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="StartDatePicker" Style="{StaticResource SingleDatePickerStyle}" SelectedDateChanged="StartDatePicker_SelectedDateChanged" Opacity="0" IsHitTestVisible="False"/>
                            <materialDesign:PackIcon Kind="Calendar" Width="25" Height="25" Foreground="#474747" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1"/>
                            <Button x:Name="StartDateButton" Grid.Column="0" Style="{StaticResource DateButtonStyle}" Click="StartDateButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ElementName=StartDatePicker, Path=SelectedDate, StringFormat='{}{0:MMM dd, yyyy}', TargetNullValue='Select date'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=StartDatePicker, Path=SelectedDate}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="#999"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock Text="Due Date:" Grid.Column="2" Grid.Row="0" Margin="0,0,0,10" FontWeight="SemiBold" Foreground="#474747"/>
                    <Border Style="{StaticResource RoundedBorderStyle}" Grid.Column="2" Grid.Row="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DueDatePicker" Style="{StaticResource SingleDatePickerStyle}" SelectedDateChanged="DueDatePicker_SelectedDateChanged" Opacity="0" IsHitTestVisible="False"/>
                            <materialDesign:PackIcon Kind="Calendar" Width="25" Height="25" Foreground="#474747" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1"/>
                            <Button x:Name="DueDateButton" Grid.Column="0" Style="{StaticResource DateButtonStyle}" Click="DueDateButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ElementName=DueDatePicker, Path=SelectedDate, StringFormat='{}{0:MMM dd, yyyy}', TargetNullValue='Select date'}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ElementName=DueDatePicker, Path=SelectedDate}" Value="{x:Null}">
                                                    <Setter Property="Foreground" Value="#999"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource RoundedButtonStyle}" Grid.Column="0" Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Stretch">
                        <RadioButton x:Name="RadBtnDueDateOnly" Margin="10" GroupName="CalculationMode" IsChecked="True" Content="Due Date Only" Foreground="#474747" FontWeight="SemiBold" FontSize="14"/>
                    </Button>
                    <Button Style="{StaticResource RoundedButtonStyle}" Grid.Column="2" Grid.Row="2" Margin="0,20,0,0" HorizontalAlignment="Stretch">
                        <RadioButton x:Name="RadBtnStartDueDate" Margin="10" GroupName="CalculationMode" Content="Start to Due Date" Foreground="#474747" FontWeight="SemiBold" FontSize="14"/>
                    </Button>

                    <CheckBox Content="Link to Calendar" Grid.Row="3" Grid.ColumnSpan="3" Margin="0,20,0,0" FontWeight="SemiBold" Foreground="#474747"/>
                </Grid>

                <!-- FULL NAME DISPLAY (no dropdown) -->
                <TextBlock Text="Assign to:" Margin="0,20,0,10" FontWeight="SemiBold" Foreground="#474747"/>
                <Border Style="{StaticResource RoundedBorderStyle}">
                    <TextBox x:Name="txtAssignTo"
                             Height="40"
                             Style="{StaticResource RoundedTextboxStyle}"
                             HorizontalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Foreground="#474747"/>
                </Border>

                <TextBlock Text="Note:" Margin="0,20,0,5" FontWeight="SemiBold" Foreground="#474747"/>

                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                    <Border DockPanel.Dock="Top" Background="#A9A9A9" Padding="4" CornerRadius="12,12,0,0" BorderThickness="1,1,1,0" BorderBrush="#545454">
                        <UniformGrid Columns="24">
                            <Button ToolTip="Bold" Padding="0" Click="Format_Bold_Click">
                                <materialDesign:PackIcon Kind="FormatBold" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Italic" Padding="0" Click="Format_Italic_Click">
                                <materialDesign:PackIcon Kind="FormatItalic" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Underline" Padding="0" Click="Format_Underline_Click">
                                <materialDesign:PackIcon Kind="FormatUnderline" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Strikethrough" Padding="0" Click="Format_Strike_Click">
                                <materialDesign:PackIcon Kind="FormatStrikethroughVariant" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Subscript" Padding="0" Click="Format_Subscript_Click">
                                <materialDesign:PackIcon Kind="FormatSubscript" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Superscript" Padding="0" Click="Format_Superscript_Click">
                                <materialDesign:PackIcon Kind="FormatSuperscript" Width="18" Height="18" Foreground="#474747"/>
                            </Button>

                            <ComboBox x:Name="cmbFontSize" Height="22" Padding="2" FontSize="10" SelectionChanged="FontSize_SelectionChanged">
                                <ComboBoxItem Content="14" IsSelected="True"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="18"/>
                                <ComboBoxItem Content="24"/>
                            </ComboBox>

                            <Button ToolTip="Font Color" Padding="0" Click="Format_TextColor_Click">
                                <materialDesign:PackIcon Kind="Palette" Width="18" Height="18" Foreground="#A070C0"/>
                            </Button>
                            <Button ToolTip="Highlight" Padding="0" Click="Format_Highlight_Click">
                                <materialDesign:PackIcon Kind="Marker" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Clear" Padding="0" Click="Format_Clear_Click">
                                <materialDesign:PackIcon Kind="Eraser" Width="18" Height="18" Foreground="#474747"/>
                            </Button>

                            <Button ToolTip="Undo" Padding="0" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=EditorBox}">
                                <materialDesign:PackIcon Kind="Undo" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Redo" Padding="0" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=EditorBox}">
                                <materialDesign:PackIcon Kind="Redo" Width="18" Height="18" Foreground="#474747"/>
                            </Button>

                            <Button ToolTip="List" Padding="0" Click="Format_List_Click">
                                <materialDesign:PackIcon Kind="FormatListBulleted" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Left" Padding="0" Click="Format_AlignLeft_Click">
                                <materialDesign:PackIcon Kind="FormatAlignLeft" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Center" Padding="0" Click="Format_AlignCenter_Click">
                                <materialDesign:PackIcon Kind="FormatAlignCenter" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Right" Padding="0" Click="Format_AlignRight_Click">
                                <materialDesign:PackIcon Kind="FormatAlignRight" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Justify" Padding="0" Click="Format_AlignJustify_Click">
                                <materialDesign:PackIcon Kind="FormatAlignJustify" Width="18" Height="18" Foreground="#474747"/>
                            </Button>

                            <Button ToolTip="Indent" Padding="0" Click="Format_IndentInc_Click">
                                <materialDesign:PackIcon Kind="FormatIndentIncrease" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Outdent" Padding="0" Click="Format_IndentDec_Click">
                                <materialDesign:PackIcon Kind="FormatIndentDecrease" Width="18" Height="18" Foreground="#474747"/>
                            </Button>

                            <Button ToolTip="Quote" Padding="0" Click="Insert_Quote_Click">
                                <materialDesign:PackIcon Kind="FormatQuoteClose" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Link" Padding="0" Click="Insert_Link_Click">
                                <materialDesign:PackIcon Kind="LinkVariant" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Image" Padding="0" Click="Insert_Image_Click">
                                <materialDesign:PackIcon Kind="ImageOutline" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Code" Padding="0" Click="Insert_Code_Click">
                                <materialDesign:PackIcon Kind="CodeBraces" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                            <Button ToolTip="Fullscreen" Padding="0" Click="Toggle_Fullscreen_Click">
                                <materialDesign:PackIcon Kind="Fullscreen" Width="18" Height="18" Foreground="#474747"/>
                            </Button>
                        </UniformGrid>
                    </Border>
                    <Border Background="White" CornerRadius="0,0,12,12" BorderBrush="#545454" BorderThickness="1,0,1,1" ClipToBounds="True">
                        <RichTextBox x:Name="EditorBox"
                                     IsDocumentEnabled="True"
                                     Background="White"
                                     BorderThickness="0"
                                     Padding="10"
                                     FontSize="14"
                                     Height="250"
                                     VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </DockPanel>

                <Grid Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Content="Add Project"
                            Width="140" Height="40"
                            FontSize="16"
                            Background="#444"
                            Foreground="White"
                            Click="Button_Click_1">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>