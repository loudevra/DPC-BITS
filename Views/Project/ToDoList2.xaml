<UserControl x:Class="DPC.Views.Project.ToDoList2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource Lexend}"
        Background="#c0c0c0">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Row - Fixed at top -->
            <RowDefinition Height="Auto"/>
            <!-- Content Row - Scrollable -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sticky Header -->
        <Border Grid.Row="0" Background="#D9D9D9" Padding="20,10" Panel.ZIndex="1">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="PlaylistPlus" Width="40" Height="40" Margin="0,0,15,0" Foreground="#474747" />
                <TextBlock Text="Add To-Do List" FontSize="35" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Lexend" Foreground="#474747" />
            </StackPanel>
        </Border>

        <!-- Main Content - Scrollable -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,10,20,20" Width="800">
                <!-- Form Content -->
                <StackPanel>

                    <!-- Task Name -->
                    <TextBlock Text="Task Name:" Margin="0,10,0,10" FontWeight="SemiBold" FontFamily="Lexend" Foreground="#474747"/>
                    <Border Style="{StaticResource RoundedBorderStyle}" Width="768">
                        <TextBox x:Name="txtTaskName" Height="30" Margin="0,0,0,5" Style="{StaticResource RoundedTextboxStyle}" Width="735"/>
                    </Border>

                    <!-- Status -->
                    <TextBlock Text="Status:" Margin="0,10,0,10" FontWeight="SemiBold" FontFamily="Lexend" Foreground="#474747"/>
                    <ComboBox x:Name="cmbStatus" Style="{StaticResource RoundedComboBoxStyle}" Width="773" Height="40" SelectedIndex="0" Margin="0">
                    </ComboBox>

                    <!-- Slider -->
                    <TextBlock Text="Progress:" Margin="0,10,0,5" FontWeight="SemiBold" FontFamily="Lexend" Foreground="#474747"/>

                    <Slider x:Name="ProgressSlider"
                            Minimum="0" Maximum="100"
                            Value="45"
                            Height="40"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,0,4"
                            Width="773">
                        <Slider.Resources>
                            <!-- Custom Thumb with Tooltip -->
                            <Style TargetType="Thumb">
                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                <Setter Property="Width" Value="20"/>
                                <Setter Property="Height" Value="20"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid>
                                                <Border Background="#333"
                                                        CornerRadius="2"
                                                        Padding="2"
                                                        Margin="0,0,0,5"
                                                        VerticalAlignment="Top"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Value, ElementName=ProgressSlider, StringFormat={}{0}%}"
                                                               Foreground="White" FontSize="10"/>
                                                </Border>
                                                <Ellipse Fill="White"
                                                         Stroke="#444"
                                                         StrokeThickness="1">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Slider.Resources>

                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Full Track Background -->
                                    <Border Height="20"
                                            CornerRadius="10"
                                            Background="White"
                                            VerticalAlignment="Center"/>

                                    <!-- Filled Portion -->
                                    <Rectangle x:Name="PART_SelectionRange"
                                               Height="10"
                                               Fill="#555"
                                               RadiusX="5" RadiusY="5"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"/>

                                    <!-- Thumb -->
                                    <Thumb x:Name="PART_Thumb"
                                           VerticalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>

                    <!-- 0% and 100% Labels -->
                    <Grid Margin="0,0,0,20" Width="773">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="0%" FontSize="15" HorizontalAlignment="Left" Foreground="#474747" FontFamily="{StaticResource Lexend}"/>
                        <TextBlock Text="100%" FontSize="15" HorizontalAlignment="Right" Grid.Column="1" Foreground="#474747" FontFamily="{StaticResource Lexend}"/>
                    </Grid>

                    <TextBlock Text="Priority:" Margin="0,10,0,10" FontWeight="SemiBold" FontFamily="Lexend" Foreground="#474747"/>
                    <!-- Cards Row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Low -->
                        <!-- Enhanced Low Priority Card -->
                        <Border x:Name="LowPriorityCard" 
        CornerRadius="16" 
        Margin="12" 
        Width="180" 
        Grid.Column="0" 
        Cursor="Hand"
        BorderThickness="0">

                            <!-- Card Background with Gradient -->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                    <GradientStop Color="#F8FFF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <!-- Subtle Shadow Effect -->
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" 
                          ShadowDepth="4" 
                          Color="#E0E0E0" 
                          Opacity="0.3"/>
                            </Border.Effect>

                            <!-- Interactive Hover/Click Effects -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!-- Hover Effect -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="16" 
                                              ShadowDepth="6" 
                                              Color="#4CAF50" 
                                              Opacity="0.4"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </Style.Triggers>
                                    <Style.Resources>
                                        <Storyboard x:Key="HoverAnimation">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     To="1.05" Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     To="1.05" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </Style.Resources>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center" 
                VerticalAlignment="Center" 
                Margin="20,16">

                                <!-- Icon Container with Colored Background -->
                                <Border Background="#E8F5E8" 
                CornerRadius="30" 
                Width="60" 
                Height="60" 
                Margin="0,0,0,12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" 
                                  ShadowDepth="2" 
                                  Color="#4CAF50" 
                                  Opacity="0.2"/>
                                    </Border.Effect>

                                    <materialDesign:PackIcon Kind="LeafMaple"
                                     Width="32" 
                                     Height="32"
                                     Foreground="#4CAF50"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                                </Border>

                                <!-- Priority Label -->
                                <TextBlock Text="Low Priority" 
                   FontWeight="SemiBold" 
                   FontSize="14" 
                   HorizontalAlignment="Center" 
                   Foreground="#4CAF50"
                   FontFamily="Lexend"/>

                                <!-- Subtitle -->
                                <TextBlock Text="Take your time" 
                   FontSize="10" 
                   HorizontalAlignment="Center" 
                   Foreground="#81C784"
                   FontFamily="Lexend"
                   Margin="0,2,0,0"
                   Opacity="0.8"/>

                                <!-- Priority Indicator Dots -->
                                <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,8,0,0">
                                    <Ellipse Width="8" Height="8" 
                     Fill="#4CAF50" 
                     Margin="2,0"/>
                                    <Ellipse Width="8" Height="8" 
                     Fill="#E8F5E8" 
                     Margin="2,0"/>
                                    <Ellipse Width="8" Height="8" 
                     Fill="#E8F5E8" 
                     Margin="2,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>


                        <!-- Medium -->
                        <Border Grid.Column="1"
        Width="170"
        Margin="10"
        CornerRadius="15"
        BorderThickness="2"
        Cursor="Hand">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="2"
                                      Opacity="0.2"/>
                                        </Setter.Value>
                                    </Setter>

                                    <!-- HOVER EFFECT -->
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="BorderBrush" Value="#FF9800"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="15">

                                <materialDesign:PackIcon Kind="ClipboardTextOutline"
                                 Width="60"
                                 Height="60"
                                 Foreground="#FF9800"
                                 HorizontalAlignment="Center"/>

                                <TextBlock Text="Medium"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#FF9800"/>
                            </StackPanel>

                        </Border>


                        <!-- High -->
                        <Border Grid.Column="2"
        Width="170"
        Margin="10"
        CornerRadius="15"
        BorderThickness="2"
        Cursor="Hand">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="12"
                                      ShadowDepth="3"
                                      Opacity="0.25"/>
                                        </Setter.Value>
                                    </Setter>

                                    <!-- Hover Effect -->
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Setter Property="BorderBrush" Value="#F44336"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="15">

                                <materialDesign:PackIcon Kind="AlertCircleOutline"
                                 Width="60"
                                 Height="60"
                                 Foreground="#F44336"
                                 HorizontalAlignment="Center"/>

                                <TextBlock Text="High"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#F44336"/>
                            </StackPanel>

                        </Border>


                        <!-- Urgent -->
                        <Border Grid.Column="3"
        Width="170"
        Margin="10"
        CornerRadius="15"
        BorderThickness="2"
        Cursor="Hand">

                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="4"
                                      Opacity="0.3"/>
                                        </Setter.Value>
                                    </Setter>

                                    <!-- Hover Effect -->
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFCDD2"/>
                                            <Setter Property="BorderBrush" Value="#D32F2F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="15">

                                <materialDesign:PackIcon Kind="AlertOctagonOutline"
                                 Width="65"
                                 Height="65"
                                 Foreground="#D32F2F"
                                 HorizontalAlignment="Center"/>

                                <TextBlock Text="URGENT"
                   FontWeight="Bold"
                   FontSize="15"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   Foreground="#D32F2F"/>
                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- Save Button -->
                    <Button
                        Content="Save"
                        Width="140" Height="38" Margin="0,24,0,0"
                        HorizontalAlignment="Right"
                        FontSize="16"
                        Background="#444"
                        Foreground="White"
                        Click="SaveToDoList"
                        BorderBrush="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="20"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="10,0"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

