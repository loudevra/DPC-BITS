<UserControl x:Class="DPC.Views.Project.ManageProject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="AddNewButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#474747"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Style="{StaticResource RoundedBorderStyle}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#AEAEAE"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Style="{StaticResource RoundedBorderStyle}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"
                                                  Margin="10,0,5,0"/>

                                <ToggleButton Name="ToggleButton"
                                              Grid.Column="1"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              BorderThickness="0"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="0,0,5,0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" BorderThickness="0">
                                                            <materialDesign:PackIcon Kind="ChevronDown" Width="20" Height="20" Foreground="#AEAEAE"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <Popup Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Style="{StaticResource RoundedBorderStyle}"
                                            Background="White"
                                            BorderBrush="#AEAEAE"
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer>
                                            <StackPanel>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedGridStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#AEAEAE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="RoundedTextboxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Lexend"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER + SUMMARY CARDS ══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="Projects" FontSize="32" FontWeight="SemiBold" FontFamily="Lexend"
                           Foreground="#555555" Width="287" Height="44"/>
            </StackPanel>

            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- AWARDED -->
                <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15,5,15,5"
                        Width="Auto" Margin="0,0,5,0" Height="80">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock x:Name="tbAwarded" Text="0" FontSize="32" FontWeight="Bold" Foreground="#89AC74"/>
                            <TextBlock Text="Awarded" FontSize="14" FontWeight="SemiBold" Foreground="#89AC74"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Ellipse Width="55" Height="55" Fill="#DEF9CE" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="CheckboxMarkedOutline" Width="40" Height="40"
                                                     Foreground="#89AC74" VerticalAlignment="Center"
                                                     HorizontalAlignment="Center" Margin="-54,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ON-GOING -->
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15,5,15,5"
                        Width="Auto" Margin="5,0,5,0" Height="80">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock x:Name="tbOnGoing" Text="0" FontSize="32" FontWeight="Bold" Foreground="#86BCD5"/>
                            <TextBlock Text="On-Going" FontSize="14" FontWeight="SemiBold" Foreground="#86BCD5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Ellipse Width="55" Height="55" Fill="#BEE4F7" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="Cached" Width="40" Height="40"
                                                     Foreground="#68B8DF" VerticalAlignment="Center"
                                                     HorizontalAlignment="Center" Margin="-54,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- COMPLETED -->
                <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15,5,15,5"
                        Width="Auto" Margin="5,0,5,0" Height="80">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock x:Name="tbCompleted" Text="0" FontSize="32" FontWeight="Bold" Foreground="#E5D18E"/>
                            <TextBlock Text="Done" FontSize="14" FontWeight="SemiBold" Foreground="#E5D18E"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Ellipse Width="55" Height="55" Fill="#FFF6D8" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="40" Height="40"
                                                     Foreground="#E5D18E" VerticalAlignment="Center"
                                                     HorizontalAlignment="Center" Margin="-54,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CANCELLED -->
                <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="15,5,15,5"
                        Width="Auto" Margin="5,0,5,0" Height="80">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                            <TextBlock x:Name="tbCancelled" Text="0" FontSize="32" FontWeight="Bold" Foreground="#E65E5E"/>
                            <TextBlock Text="Cancelled" FontSize="14" FontWeight="SemiBold" Foreground="#E65E5E"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Ellipse Width="55" Height="55" Fill="#FFCDD2" VerticalAlignment="Center"/>
                            <materialDesign:PackIcon Kind="CloseCircleOutline" Width="40" Height="40"
                                                     Foreground="#E65E5E" VerticalAlignment="Center"
                                                     HorizontalAlignment="Center" Margin="-54,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ══ TOOLBAR ══ -->
        <Border Grid.Row="1" Padding="5" Background="White" CornerRadius="10"
                BorderBrush="White" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnExportExcel" Click="BtnExportExcel_Click"
                            Style="{StaticResource RoundedButtonStyle}"
                            Background="#456B2E" Foreground="White"
                            Width="75" Height="29" Margin="10,0,10,0">
                        <materialDesign:PackIcon Kind="MicrosoftExcel" Width="25" Height="25"/>
                    </Button>

                    <ComboBox x:Name="cmbPageSize" SelectionChanged="CmbPageSize_SelectionChanged"
          Width="150" Style="{StaticResource RoundedComboBoxStyle}"
          Height="28" Foreground="#000000" BorderBrush="#000000" Margin="0,0,10,0">

                        <!-- Shorter implementation of the blue hover effect -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="5,2">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E5F3FF" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#70C0FF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>

                        <ComboBoxItem Content="DPC GOV SALES" IsSelected="True"/>
                        <ComboBoxItem Content="AWARDED PROJECTS"/>
                        <ComboBoxItem Content="COLLECTION"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Style="{StaticResource RoundedGridStyle}" MinWidth="200" Width="250" Height="36" BorderBrush="#000000">
                        <Grid>
                            <TextBox x:Name="txtSearch"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontFamily="Lexend"
                                     Height="23"
                                     Margin="10,0,30,0"
                                     VerticalAlignment="Center"
                                     Style="{StaticResource RoundedTextboxStyle}"/>
                            <TextBlock Text="Search"
                                       Foreground="#AEAEAE"
                                       FontSize="14"
                                       FontFamily="Lexend"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       IsHitTestVisible="False"
                                       Panel.ZIndex="-1">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <materialDesign:PackIcon Kind="Magnify" Width="25" Height="26"
                                                     Foreground="#000000"
                                                     HorizontalAlignment="Right" VerticalAlignment="Center"
                                                     Margin="0,0,5,0" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ DATA GRID ══ -->
        <Border Grid.Row="2" Background="White" CornerRadius="8"
                BorderBrush="#D4E3F0" BorderThickness="1"
                ClipToBounds="True" Margin="0,0,0,15">
            <DataGrid x:Name="ProjectDataGrid"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFCFD"
                      BorderThickness="0"
                      RowHeight="40">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontFamily" Value="Lexend"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#474747"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="SeparatorBrush" Value="#5A5A5A"/>
                        <Setter Property="SeparatorVisibility" Value="Visible"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="BorderBrush" Value="#5A5A5A"/>
                    </Style>

                    <Style x:Key="TextCell" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="10,0,0,0"/>
                        <Setter Property="FontFamily" Value="Lexend"/>
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <!-- # -->
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding ProjectID}"
                                        Width="45"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Date -->
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding ProjectDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                        Width="105"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Reference Number -->
                    <DataGridTextColumn Header="Ref #"
                                        Binding="{Binding ReferenceNumber}"
                                        Width="120"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Project Title -->
                    <DataGridTextColumn Header="Project Title"
                                        Binding="{Binding ProjectTitle}"
                                        Width="*"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Category -->
                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}"
                                        Width="130"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Project Type -->
                    <DataGridTextColumn Header="Type"
                                        Binding="{Binding ProjectType}"
                                        Width="80"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- ABC -->
                    <DataGridTextColumn Header="ABC"
                                        Binding="{Binding ABC, StringFormat='{}{0:N0}'}"
                                        Width="110"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Closing Date -->
                    <DataGridTextColumn Header="Closing Date"
                                        Binding="{Binding ClosingDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                        Width="105"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Status (colored dot) -->
                    <DataGridTemplateColumn Header="Status" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Gray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="AWARDED">
                                                        <Setter Property="Fill" Value="#89AC74"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="DONE">
                                                        <Setter Property="Fill" Value="#E5D18E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="CANCELLED">
                                                        <Setter Property="Fill" Value="#E65E5E"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="ON-GOING">
                                                        <Setter Property="Fill" Value="#86BCD5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="FOR FOLLOW-UP">
                                                        <Setter Property="Fill" Value="#F4A261"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="FOR EMAIL">
                                                        <Setter Property="Fill" Value="#A78BFA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                               FontFamily="Lexend" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Remarks -->
                    <DataGridTextColumn Header="Remarks"
                                        Binding="{Binding Remarks}"
                                        Width="100"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Assign Sales -->
                    <DataGridTextColumn Header="Sales"
                                        Binding="{Binding AssignSales}"
                                        Width="90"
                                        ElementStyle="{StaticResource TextCell}"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Width="30" Height="30" Background="White"
                                            Margin="0,0,5,0"
                                            Tag="{Binding ProjectID}"
                                            Click="BtnEdit_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5" BorderThickness="0">
                                                    <materialDesign:PackIcon Kind="SquareEditOutline"
                                                                             Width="16" Height="16"
                                                                             Foreground="#52C69D"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Width="30" Height="30" Background="White"
                                            Tag="{Binding ProjectID}"
                                            Click="BtnDelete_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5" BorderThickness="0">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                             Width="16" Height="16"
                                                                             Foreground="#C0392B"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══ PAGINATION ══ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Border Background="White" CornerRadius="30" Padding="10,5" BorderThickness="2" BorderBrush="#adadad">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

                    <Button x:Name="btnPrev" Content="&lt;" FontSize="14" Width="30" Height="30"
                            Background="Transparent" BorderBrush="Transparent"
                            FontFamily="Lexend" Foreground="#adadad" Click="BtnPrev_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ItemsControl x:Name="PageButtonsPanel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Button x:Name="btnNext" Content="&gt;" FontSize="14" Width="30" Height="30"
                            Background="Transparent" BorderBrush="Transparent"
                            FontFamily="Lexend" Foreground="#555555" FontWeight="Bold" Click="BtnNext_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</UserControl>
