<UserControl x:Class="DPC.Views.Project.ManageProject"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="AddNewButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#474747"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="15"/>
        </Style>

        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Style="{StaticResource RoundedBorderStyle}" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
            <Setter Property="BorderBrush" Value="#AEAEAE"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Style="{StaticResource RoundedBorderStyle}" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="35" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      VerticalAlignment="Center"
                                      Margin="10,0,5,0"/>

                                <ToggleButton Name="ToggleButton" 
                                  Grid.Column="1"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  BorderThickness="0"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <Border Background="Transparent" BorderThickness="0">
                                                            <materialDesign:PackIcon Kind="ChevronDown" Width="20" Height="20" Foreground="#AEAEAE"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <Popup Name="Popup"
                           Placement="Bottom"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           AllowsTransparency="True"
                           Focusable="False"
                           MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Style="{StaticResource RoundedBorderStyle}" 
                                Background="White" 
                                BorderBrush="#AEAEAE"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer>
                                            <StackPanel>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedGridStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="BorderBrush" Value="#AEAEAE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <Style x:Key="RoundedTextboxStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Lexend"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="1" Margin="20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="Projects" FontSize="32" FontWeight="SemiBold" FontFamily="Lexend" Foreground="#555555" Width="287" Height="44"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15,5,15,5" Width="Auto" Margin="0,0,5,0" Height="80">
                                <Grid>
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock x:Name="tbWaiting" Text="0" FontSize="32" FontWeight="Bold" Foreground="#E5D18E"/>
                                        <TextBlock Text="Waiting" FontSize="14" FontWeight="SemiBold" Foreground="#E5D18E"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse Width="55" Height="55" Fill="#FFF6D8" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="40" Height="40" Foreground="#E5D18E" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-54,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15,5,15,5" Width="Auto" Margin="5,0,5,0" Height="80">
                                <Grid>
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock x:Name="tbProcessing" Text="0" FontSize="32" FontWeight="Bold" Foreground="#86BCD5"/>
                                        <TextBlock Text="Processing" FontSize="14" FontWeight="SemiBold" Foreground="#86BCD5"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse Width="55" Height="55" Fill="#BEE4F7" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="Cached" Width="40" Height="40" Foreground="#68B8DF" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-54,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15,5,15,5" Width="Auto" Margin="5,0,5,0" Height="80">
                                <Grid>
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock x:Name="tbSolved" Text="0" FontSize="32" FontWeight="Bold" Foreground="#89AC74"/>
                                        <TextBlock Text="Solved " FontSize="14" FontWeight="SemiBold" Foreground="#89AC74"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse Width="55" Height="55" Fill="#DEF9CE" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="CheckboxMarkedOutline" Width="40" Height="40" Foreground="#89AC74" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-54,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Column="3" Background="White" CornerRadius="8" Padding="15,5,15,5" Width="Auto" Margin="5,0,5,0" Height="80">
                                <Grid>
                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                        <TextBlock x:Name="tbTotal" Text="0" FontSize="32" FontWeight="Bold" Foreground="#E65E5E"/>
                                        <TextBlock Text="Cancelled" FontSize="14" FontWeight="SemiBold" Foreground="#E65E5E"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Ellipse Width="55" Height="55" Fill="#FFCDD2" VerticalAlignment="Center"/>
                                        <materialDesign:PackIcon Kind="ChartPieOutline" Width="40" Height="40" Foreground="#E65E5E" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="-54,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Padding="5" Background="White" CornerRadius="10" BorderBrush="White" Margin="0,0,0,15" >
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="btnExportExcel" Click="BtnExportExcel_Click" Style="{StaticResource RoundedButtonStyle}" Background="#456B2E" Foreground="White" Width="75" Height="29" Margin="10,0,10,0">
                                        <materialDesign:PackIcon Kind="MicrosoftExcel" Width="25" Height="25"/>
                                    </Button>

                                    <ComboBox Width="75" Style="{StaticResource RoundedComboBoxStyle}" Height="28" Foreground="#AEAEAE" Margin="0,0,10,0">
                                        <ComboBoxItem Content="10" IsSelected="True"/>
                                        <ComboBoxItem Content="25"/>
                                        <ComboBoxItem Content="50"/>
                                        <ComboBoxItem Content="100"/>
                                    </ComboBox>

                                    <Button Style="{StaticResource RoundedButtonStyle}" Background="Transparent" Foreground="#474747" Width="29" Height="29" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="ViewGridOutline" Width="25" Height="25"/>
                                    </Button>
                                    <Button Style="{StaticResource RoundedButtonStyle}" Background="Transparent" Foreground="#474747" Width="29" Height="29" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="FormatListBulleted" Width="30" Height="30"/>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Border Style="{StaticResource RoundedGridStyle}" MinWidth="200" Width="250" Height="36">
                                        <Grid>
                                            <TextBox x:Name="txtSearch"
                 BorderThickness="0"
                 Background="Transparent"
                 FontFamily="Lexend"
                 Height="23"
                 Margin="10,0,30,0"
                 VerticalAlignment="Center"
                 Style="{StaticResource RoundedTextboxStyle}"/>
                                            <TextBlock Text="Search"
                   Foreground="#AEAEAE"
                   FontSize="14"
                   FontFamily="Lexend"
                   VerticalAlignment="Center"
                   Margin="12,0,0,0"
                   IsHitTestVisible="False"
                   Panel.ZIndex="-1">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtSearch}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <materialDesign:PackIcon Kind="Magnify" Width="25" Height="26" Foreground="#AEAEAE" 
                                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                                 IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>


                        <Border Background="White" CornerRadius="8" BorderBrush="#D4E3F0" BorderThickness="1" ClipToBounds="True">
                            <StackPanel>
                                <DataGrid x:Name="ProjectDataGrid"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#F0F0F0"
          RowBackground="White"
          AlternatingRowBackground="#FAFCFD"
          BorderThickness="0"
          RowHeight="40"
          HorizontalScrollBarVisibility="Disabled">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#F4F8FB"/>
                                            <Setter Property="Foreground" Value="#0A5A97"/>
                                            <Setter Property="FontFamily" Value="Lexend"/>
                                            <Setter Property="FontSize" Value="13"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                            <Setter Property="BorderBrush" Value="#D4E3F0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        </Style>

                                        <Style x:Key="TextCell" TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="10,0,0,0"/>
                                            <Setter Property="FontFamily" Value="Lexend"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGrid.Resources>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"             Binding="{Binding ProjectID}"        Width="50" ElementStyle="{StaticResource TextCell}"/>

                                        <DataGridTextColumn Header="Project"  Binding="{Binding ProjectName}"      Width="*" ElementStyle="{StaticResource TextCell}"/>

                                        <DataGridTemplateColumn Header="Status" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="Gray"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                                                            <Setter Property="Fill" Value="#E5D18E"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Processing">
                                                                            <Setter Property="Fill" Value="#86BCD5"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Solved">
                                                                            <Setter Property="Fill" Value="#89AC74"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                            <Setter Property="Fill" Value="#E65E5E"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontFamily="Lexend" FontSize="12"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Customer"      Binding="{Binding Customer}"         Width="*" ElementStyle="{StaticResource TextCell}"/>

                                        <DataGridTextColumn Header="ABC"           Binding="{Binding Budget, StringFormat='{}{0:N0}'}" Width="0.8*" ElementStyle="{StaticResource TextCell}"/>
                                        <DataGridTextColumn Header="Start Date"    Binding="{Binding StartDate, StringFormat='{}{0:MMM dd, yyyy}'}"  Width="105" ElementStyle="{StaticResource TextCell}"/>
                                        <DataGridTextColumn Header="Due Date"      Binding="{Binding DueDate, StringFormat='{}{0:MMM dd, yyyy}'}"    Width="105" ElementStyle="{StaticResource TextCell}"/>
                                        <DataGridTextColumn Header="Assigned To"   Binding="{Binding AssignedToName}" Width="*" ElementStyle="{StaticResource TextCell}"/>

                                        <DataGridTemplateColumn Header="Actions" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Width="30" Height="30"
                                Background="White"
                                Margin="0,0,5,0"
                                Tag="{Binding ProjectID}"
                                Click="BtnEdit_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5"
                                            BorderBrush="#AEAEAE"
                                            BorderThickness="1">
                                                                        <materialDesign:PackIcon Kind="SquareEditOutline" 
                                                                 Width="16" Height="16"
                                                                 Foreground="#52C69D"
                                                                 HorizontalAlignment="Center" 
                                                                 VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <Button Width="30" Height="30"
                                Background="White"
                                Tag="{Binding ProjectID}"
                                Click="BtnDelete_Click">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5"
                                            BorderBrush="#AEAEAE"
                                            BorderThickness="1">
                                                                        <materialDesign:PackIcon Kind="TrashCanOutline" 
                                                                 Width="16" Height="16"
                                                                 Foreground="#C0392B"
                                                                 HorizontalAlignment="Center" 
                                                                 VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Border Background="White" CornerRadius="30" Padding="10,5" BorderThickness="2" BorderBrush="#adadad">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

                                    <Button x:Name="btnPrev" Content="&lt;" FontSize="14" Width="30" Height="30"
                    Background="Transparent" BorderBrush="Transparent"
                    FontFamily="Lexend" Foreground="#adadad" Click="BtnPrev_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <ItemsControl x:Name="PageButtonsPanel">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <Button x:Name="btnNext" Content="&gt;" FontSize="14" Width="30" Height="30"
                    Background="Transparent" BorderBrush="Transparent"
                    FontFamily="Lexend" Foreground="#555555" FontWeight="Bold" Click="BtnNext_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>