<UserControl x:Class="FileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DPC"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1400"
             FontFamily="Lexend" FontWeight="Light">
    <Grid Background="#F4F6F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Client Information" FontSize="26" FontWeight="Bold" Foreground="#2A3547" VerticalAlignment="Center"/>

            <Border Grid.Column="3" Background="White" CornerRadius="17.5" Height="35" VerticalAlignment="Center" Padding="15,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Path Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14Z" 
                          Fill="#475569" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBox Grid.Column="1" Text="Search Files" Foreground="#94A3B8" BorderThickness="0" 
                             VerticalAlignment="Center" Background="Transparent" FontSize="13" TextChanged="TextBox_TextChanged"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="30,0,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="0,0,20,0">
                <StackPanel>
                    <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Path Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                      Fill="#475569" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text= "Client Profile" Foreground="#2A3547" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Full Name" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Height="35" Margin="0,0,0,15">
                                <TextBox x:Name="txtFullName" Background="Transparent" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Foreground="#1E293B" IsReadOnly="True"/>
                            </Border>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Phone Number" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Height="35">
                                        <TextBox x:Name="txtPhone" Background="Transparent" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Foreground="#1E293B" IsReadOnly="True"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Email Address" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Height="35">
                                        <TextBox x:Name="txtEmail" Background="Transparent" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Foreground="#1E293B" IsReadOnly="True"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Path Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z" 
                                      Fill="#475569" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Billing Address" Foreground="#2A3547" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Address" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Height="35" Margin="0,0,0,15">
                                <TextBox x:Name="txtAddress" Background="Transparent" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Foreground="#1E293B" IsReadOnly="True"/>
                            </Border>

                            <TextBlock Text="City" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Height="35" Margin="0,0,0,15">
                                <TextBox x:Name="txtCity" Background="Transparent" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Foreground="#1E293B" IsReadOnly="True"/>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Region / State" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Height="35">
                                        <TextBox x:Name="txtRegion" Background="Transparent" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Foreground="#1E293B" IsReadOnly="True"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Zip Code" Foreground="#475569" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Background="White" Height="35">
                                        <TextBox x:Name="txtZipCode" Background="Transparent" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" Foreground="#1E293B" IsReadOnly="True"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="30">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z" 
                                  Fill="#475569" Width="22" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                            <TextBlock Text="Client Documents" Foreground="#1E293B" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="25,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Document Name" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="Date Created" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" BorderThickness="0">
                        <StackPanel>

                            <Expander Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6H12L10,4Z" 
                                              Fill="#CBD5E1" Width="20" Height="18" Stretch="Uniform" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="CE (Cost Estimates)" Foreground="#334155" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>

                                <ItemsControl x:Name="CEFilesList" Margin="35,5,0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6*"/>
                                                    <ColumnDefinition Width="3*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Margin="0,0,20,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z" 
                                                          Fill="#64748B" Width="14" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" Click="OpenFile_Click" ToolTip="{Binding FileName}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="{Binding FileName}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline" TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding DateCreated}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6H12L10,4Z" 
                                              Fill="#CBD5E1" Width="20" Height="18" Stretch="Uniform" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="BS (Billing Statements)" Foreground="#334155" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>

                                <ItemsControl x:Name="BSFilesList" Margin="35,5,0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6*"/>
                                                    <ColumnDefinition Width="3*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Margin="0,0,20,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z" 
                                                          Fill="#64748B" Width="14" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" Click="OpenFile_Click" ToolTip="{Binding FileName}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="{Binding FileName}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline" TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding DateCreated}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6H12L10,4Z" 
                                              Fill="#CBD5E1" Width="20" Height="18" Stretch="Uniform" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="DR (Delivery Receipts)" Foreground="#334155" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>

                                <ItemsControl x:Name="DRFilesList" Margin="35,5,0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6*"/>
                                                    <ColumnDefinition Width="3*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Margin="0,0,20,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z" 
                                                          Fill="#64748B" Width="14" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" Click="OpenFile_Click" ToolTip="{Binding FileName}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="{Binding FileName}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline" TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding DateCreated}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8A2,2 0 0,0 20,6H12L10,4Z" 
                                              Fill="#CBD5E1" Width="20" Height="18" Stretch="Uniform" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="SOA (Statement of Account)" Foreground="#334155" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Expander.Header>

                                <ItemsControl x:Name="SOAFilesList" Margin="35,5,0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6*"/>
                                                    <ColumnDefinition Width="3*"/>
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Margin="0,0,20,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="0" Data="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2Z" 
                                                          Fill="#64748B" Width="14" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0" Click="OpenFile_Click" ToolTip="{Binding FileName}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="Transparent">
                                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <TextBlock Text="{Binding FileName}" Foreground="#1E293B" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline" TextTrimming="CharacterEllipsis"/>
                                                    </Button>
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding DateCreated}" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="13"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>