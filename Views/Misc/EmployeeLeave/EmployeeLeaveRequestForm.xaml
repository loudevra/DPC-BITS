<UserControl x:Class="DPC.Views.Misc.EmployeeLeave.EmployeeLeaveRequestForm" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#D9D9D9"
             FontFamily="{StaticResource Lexend}"
             Foreground="#474747"
             d:DesignHeight="1250" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}" Margin="25,10,25,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="CalendarAccountOutline" Width="40" Height="40" Margin="0,0,15,0"/>
                <TextBlock Text="Employee Leave Request Form" FontSize="25" FontWeight="DemiBold" VerticalAlignment="Center" Margin="0,0,0,-3"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ModernScrollViewerStyle}">
            <StackPanel Orientation="Vertical" Margin="0,10,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EMPLOYEE NAME" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Center" Margin="10,0,0,5"/>
                            <TextBlock Text=" *" Foreground="Red" FontSize="16" FontWeight="UltraBold"/>
                        </StackPanel>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <Grid>
                                <TextBox x:Name="AutoCompleteTextBox" FontFamily="{StaticResource Lexend}" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" VerticalAlignment="Top"
                                         TextChanged="AutoCompleteTextBox_TextChanged"
                                         PreviewKeyDown="AutoCompleteTextBox_PreviewKeyDown" CharacterCasing="Upper"/>

                                <Popup x:Name="AutoCompletePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=AutoCompleteTextBox}" StaysOpen="False" AllowsTransparency="True" Focusable="False" IsOpen="False">
                                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                                        <ListBox x:Name="SuggestionListBox" PreviewMouseLeftButtonUp="SuggestionListBox_PreviewMouseLeftButtonDown" FontFamily="{StaticResource Lexend}" FontSize="14" Width="{Binding ActualWidth, ElementName=AutoCompleteTextBox}" MaxHeight="150" Padding="3" BorderThickness="0" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
                        <TextBlock Text="EMPLOYEE ID" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="EmployeeID" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" IsReadOnly="True" CharacterCasing="Upper"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0" Margin="10">
                        <TextBlock Text="TODAY'S DATE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="TodayDatePicker" Style="{StaticResource SingleDatePickerStyle}" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="25" Height="25" Foreground="#474747" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                <Button Grid.Column="1" Click="TodayDate_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand" Height="35">
                                    <TextBlock Text="{Binding ElementName=TodayDatePicker, Path=SelectedDate, StringFormat='MMMM dd, yyyy', TargetNullValue='Select Date'}" FontFamily="{StaticResource Lexend}" FontSize="14" Foreground="#474747" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="10">
                        <TextBlock Text="EMPLOYEE EMAIL" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="EmployeeEmail" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="10">
                        <TextBlock Text="WORK PHONE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="WorkPhone" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" 
                                     PreviewTextInput="NumericOnly_PreviewTextInput" CharacterCasing="Upper" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="1" Margin="10">
                        <TextBlock Text="PERSONAL PHONE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="PersonalPhone" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" 
                                     PreviewTextInput="NumericOnly_PreviewTextInput" CharacterCasing="Upper"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="2" Margin="10">
                        <TextBlock Text="DEPARTMENT NAME" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="Department" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" CharacterCasing="Upper"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Margin="10">
                        <TextBlock Text="SUPERVISOR NAME" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="SupervisorName" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" CharacterCasing="Upper"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="LEAVE DETAILS" FontFamily="{StaticResource Lexend}" FontWeight="ExtraBlack" FontSize="18" TextAlignment="Left" Margin="20,20,0,10"/>

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#474747" Padding="5,5,5,5" CornerRadius="20,0,0,0" Grid.Column="0">
                        <TextBlock Text="START DATE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Foreground="#d9d9d9"/>
                    </Border>
                    <Border Background="#474747" Padding="5,10,5,10" Grid.Column="1">
                        <TextBlock Text="END DATE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Foreground="#d9d9d9"/>
                    </Border>
                    <Border Background="#474747" Padding="5,10,5,10" Grid.Column="2">
                        <TextBlock Text="HOURS REQUESTED" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Foreground="#d9d9d9"/>
                    </Border>
                    <Border Background="#474747" Padding="5,10,5,10" CornerRadius="0,20,0,0" Grid.Column="3">
                        <TextBlock Text="LEAVE CODE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Foreground="#d9d9d9"/>
                    </Border>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Grid.Row="1">
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,5,0" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="StartDatePicker" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                    <Button Grid.ColumnSpan="2" Click="StartDate_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center" Height="35">
                                        <TextBlock Text="{Binding ElementName=StartDatePicker, Path=SelectedDate, StringFormat='MMMM dd, yyyy', TargetNullValue='Select Date'}" FontFamily="{StaticResource Lexend}" Foreground="#474747" VerticalAlignment="Center" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,5,0" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="EndDatePicker" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                    <Button Grid.ColumnSpan="2" Click="EndDate_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center" Height="35">
                                        <TextBlock Text="{Binding ElementName=EndDatePicker, Path=SelectedDate, StringFormat='MMMM dd, yyyy', TargetNullValue='Select Date'}" FontFamily="{StaticResource Lexend}" Foreground="#474747" VerticalAlignment="Center" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,5,0" Background="White" Padding="5,0,5,0">
                                <TextBox x:Name="txtHours" Height="35" VerticalContentAlignment="Center" FontFamily="{StaticResource Lexend}" TextAlignment="Center" FontSize="14" FontWeight="Bold" Background="Transparent" BorderThickness="0" materialDesign:TextFieldAssist.DecorationVisibility="Hidden" CharacterCasing="Upper"/>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,0" Background="White" Padding="5,0,5,0">
                                <ComboBox x:Name="CbLeaveCode" Style="{StaticResource RoundedComboBoxStyle}" Height="35" BorderThickness="0" FontFamily="{StaticResource Lexend}" FontSize="14" materialDesign:TextFieldAssist.DecorationVisibility="Hidden">
                                    <ComboBoxItem Content="Vacation (VC)"/>
                                    <ComboBoxItem Content="Sick (S)"/>
                                    <ComboBoxItem Content="Bereavement (BV)"/>
                                    <ComboBoxItem Content="Leave Without Pay (LWOP)"/>
                                    <ComboBoxItem Content="Vacational Leave (VL)"/>
                                    <ComboBoxItem Content="Maternity Leave (ML)"/>
                                    <ComboBoxItem Content="Earned Leave (EL)"/>
                                    <ComboBoxItem Content="Half-Day (HD)"/>
                                    <ComboBoxItem Content="Other (OTH)"/>
                                </ComboBox>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid Margin="10,20,10,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="10,0,10,15">
                        <TextBlock Text="EMPLOYEE NAME" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" IsReadOnly="True" Text="{Binding ElementName=AutoCompleteTextBox, Path=Text}" Background="#EAEAEA" Foreground="#555555" CharacterCasing="Upper"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,10,15">
                        <TextBlock Text="EMPLOYEE SIGNATURE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="10,0,0,5"/>
                        <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747" Height="39">
                            <TextBlock Text="E-Signature Required" FontFamily="{StaticResource Lexend}" FontSize="14" FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="10,0,10,15">
                        <TextBlock Text="DATE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" IsReadOnly="True" Text="{Binding ElementName=TodayDatePicker, Path=SelectedDate, StringFormat='MMMM dd, yyyy'}" Background="#EAEAEA" Foreground="#555555" CharacterCasing="Upper"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="10,10,10,0">
                        <TextBlock Text="SUPERVISOR NAME" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" IsReadOnly="True" Text="{Binding ElementName=SupervisorName, Path=Text}" Background="#EAEAEA" Foreground="#555555" CharacterCasing="Upper"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,10,0">
                        <TextBlock Text="SUPERVISOR SIGNATURE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="10,0,0,5"/>
                        <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747" Height="39">
                            <TextBlock Text="E-Signature Required" FontFamily="{StaticResource Lexend}" FontSize="14" FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="10,10,10,0">
                        <TextBlock Text="DATE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="SupervisorDate" Style="{StaticResource SingleDatePickerStyle}" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="20" Height="20" Foreground="#474747" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                <Button Grid.Column="1" Click="SupervisorDate_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand" Height="35">
                                    <TextBlock Text="{Binding ElementName=SupervisorDate, Path=SelectedDate, StringFormat='MMMM dd, yyyy', TargetNullValue='Select Date'}" FontFamily="{StaticResource Lexend}" FontSize="14" Foreground="#474747" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock Text="LEAVE CODES" FontFamily="{StaticResource Lexend}" FontWeight="ExtraBlack" FontSize="18" TextAlignment="Left" Margin="20,20,0,0"/>
                <TextBlock Text="enter description for codes not listed" FontFamily="{StaticResource Lexend}" FontSize="12" FontStyle="Italic" Margin="20,0,0,10" Foreground="#666666"/>

                <Border Background="#F0F0F0" BorderBrush="#B0B0B0" BorderThickness="1" CornerRadius="5" Margin="10,0,10,20" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="DESCRIPTION" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="CODE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="DESCRIPTION" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="CODE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vacation" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="VC" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sick" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="S" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bereavement" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="BV" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Leave Without Pay" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="LWOP" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Vacational Leave" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="VL" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Maternity Leave" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="ML" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Earned Leave" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="EL" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="OTHER" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="OTH" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Half-Day" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="HD" FontFamily="{StaticResource Lexend}" FontSize="14" Margin="0,5"/>
                    </Grid>
                </Border>

                <TextBlock Text="ADMINISTRATIVE USE ONLY" FontFamily="{StaticResource Lexend}" FontWeight="ExtraBlack" FontSize="18" TextAlignment="Left" Margin="20,10,0,10"/>

                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5,0,10,0">
                        <TextBlock Text="APPROVED BY" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747" Height="39">
                            <ComboBox Style="{StaticResource RoundedComboBoxStyle}" BorderThickness="0" Margin="15,0,0,0" x:Name="CbApprover" FontFamily="{StaticResource Lexend}" FontSize="14">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Parvit Kumar"/>
                                <ComboBoxItem Content="Alecksandra Balingit"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5,0,10,0">
                        <TextBlock Text="DATE OF APPROVAL" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747" Height="39">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="ApprovalDate" Style="{StaticResource SingleDatePickerStyle}" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="20" Height="20" Foreground="#474747" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                <Button Grid.Column="1" Click="ApprovalDate_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                    <TextBlock Text="{Binding ElementName=ApprovalDate, Path=SelectedDate, StringFormat='MMMM dd, yyyy', TargetNullValue='Select Date'}" FontFamily="{StaticResource Lexend}" Foreground="#474747" Margin="10,0,0,0"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5,0,10,0">
                        <TextBlock Text="SIGNATURE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747" Height="39">
                            <TextBlock Text="E-Signature Required" FontFamily="{StaticResource Lexend}" FontSize="14" FontStyle="Italic" Foreground="Gray" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Button Style="{StaticResource RoundedButtonStyle}" x:Name="BtnSubmit" BorderThickness="0" FontSize="16" FontFamily="{StaticResource Lexend}" Width="200" HorizontalAlignment="Right" Margin="0,40,10,20" Cursor="Hand" Background="#52C69D">
                    <TextBlock Text="SUBMIT REQUEST" TextAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>