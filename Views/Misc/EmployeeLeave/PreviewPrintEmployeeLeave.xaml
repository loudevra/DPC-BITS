<UserControl x:Class="DPC.Views.Misc.EmployeeLeave.PreviewPrintEmployeeLeave"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="#D9D9D9">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="False" Margin="20,20,20,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Content="Cancel" Click="CancelPrint" Margin="0,0,5,0" Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="20" Foreground="Gray" BorderBrush="Gray" FontWeight="SemiBold" FontSize="14px" Width="80" Height="35"/>
                        <Button Content="Print" Click="SavePrint" Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="20" Foreground="White" FontWeight="SemiBold" FontSize="14px" Width="80" Height="35" Background="#2E466B"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel x:Name="PrintPreview" Grid.Row="1" Margin="20,10,20,20" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Border Width="793" Height="1000" Background="White" CornerRadius="0,0,10,10" BorderThickness="0" Padding="15">
                        <Grid>
                            <Image Source="/Assets/images/DREAMPCBUILD WATERMARK SLANTED SPACED.png" Stretch="UniformToFill" Opacity="0.05" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,20" Background="Transparent">
                                    <Border Width="60" Height="60" Background="Black">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/images/logo.png"/>
                                        </Border.OpacityMask>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,20">
                                    <TextBlock Text="EMPLOYEE LEAVE REQUEST FORM" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="20" Foreground="#090909" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="EMPLOYEE NAME" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="EMPLOYEE ID NUMBER" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="TODAY'S DATE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>

                                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,15,10" Height="25">
                                        <TextBlock x:Name="txtEmployeeName" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,15,10" Height="25">
                                        <TextBlock x:Name="txtEmployeeID" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,0,10" Height="25">
                                        <TextBlock x:Name="txtRequestDate" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="EMPLOYEE EMAIL" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="WORK PHONE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="PERSONAL PHONE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>

                                    <Border Grid.Row="3" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,15,10" Height="25">
                                        <TextBlock x:Name="txtEmployeeEmail" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,15,10" Height="25">
                                        <TextBlock x:Name="txtWorkPhone" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="3" Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,0,10" Height="25">
                                        <TextBlock x:Name="txtPersonalPhone" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="DEPARTMENT NAME" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="SUPERVISOR NAME" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>

                                    <Border Grid.Row="5" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,15,10" Height="25">
                                        <TextBlock x:Name="txtDepartment" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,0,10" Height="25">
                                        <TextBlock x:Name="txtSupervisorName" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="2" Text="LEAVE DETAILS" FontWeight="ExtraBold" FontFamily="{StaticResource Lexend}" FontSize="13" Margin="0,20,0,10"/>
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="START DATE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="END DATE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="NUMBER OF HOURS REQUESTED" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="LEAVE CODE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>

                                    <Border Grid.Row="1" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,15,0" Height="30">
                                        <TextBlock x:Name="txtStartDate" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,15,0" Height="30">
                                        <TextBlock x:Name="txtEndDate" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,15,0" Height="30">
                                        <TextBlock x:Name="txtHoursRequested" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="3" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,0,0" Height="30">
                                        <TextBlock x:Name="txtLeaveCode" FontSize="12" FontFamily="{StaticResource Lexend}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="4" Margin="0,50,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="EMPLOYEE NAME" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="EMPLOYEE SIGNATURE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="DATE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="txtEmpSignName" FontSize="12" FontFamily="{StaticResource Lexend}" Margin="3,5,0,20"/>

                                    <TextBlock Grid.Row="1" Grid.Column="2" x:Name="txtEmpSignDate" FontSize="12" FontFamily="{StaticResource Lexend}" Margin="3,5,0,20"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="SUPERVISOR NAME" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="SUPERVISOR SIGNATURE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="DATE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" x:Name="txtSupSignName" FontSize="12" FontFamily="{StaticResource Lexend}" Margin="3,5,0,20"/>
                                    
                                    <TextBlock Grid.Row="3" Grid.Column="2" x:Name="txtSupSignDate" FontSize="12" FontFamily="{StaticResource Lexend}" Margin="3,5,0,20"/>
                                </Grid>

                                <StackPanel Grid.Row="5" Margin="0,40,0,0">
                                    <TextBlock Text="LEAVE CODES" FontWeight="ExtraBold" FontFamily="{StaticResource Lexend}" FontSize="13" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="DESCRIPTION" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="CODE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="DESCRIPTION" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="CODE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="11" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vacation" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="VC" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Sick" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="S" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Bereavement" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="BV" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Leave Without Pay" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="LWOP" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Vacational Leave" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="VL" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Maternity Leave" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="ML" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Earned Leave" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="EL" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="OTHER" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="OTH" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Half-Day" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                        <TextBlock Grid.Row="4" Grid.Column="3" Text="HD" FontFamily="{StaticResource Lexend}" FontSize="12" Margin="0,5"/>
                                    </Grid>
                                </StackPanel>

                                <TextBlock Grid.Row="6" Text="ADMINISTRATIVE USE ONLY" FontWeight="ExtraBold" FontFamily="{StaticResource Lexend}" FontSize="13" Margin="0,40,0,10"/>
                                <Grid Grid.Row="7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="APPROVED BY" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="DATE OF APPROVAL" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="SIGNATURE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" x:Name="txtApprovedBy" FontSize="12" FontFamily="{StaticResource Lexend}" Margin="3,5,0,20"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtApprovalDate" FontSize="12" FontFamily="{StaticResource Lexend}" Margin="3,5,0,20"/>
                                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="0,0,0,0" Margin="0,0,20,20" Height="25"/>
                                </Grid>

                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>