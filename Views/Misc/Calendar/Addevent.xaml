<UserControl x:Class="DPC.Views.Misc.Calendar.Addevent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="450">
    <Grid Background="#000000">
        <Border CornerRadius="16" Margin="25" Background="#FFFFFF" BorderBrush="#E0E0E0"
                BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3" Direction="270" Color="Black"/>
            </Border.Effect>
            <StackPanel Margin="35" Width="320">
                <TextBlock Text="Event Information" FontWeight="Bold" FontSize="22" 
                           Foreground="#1C1A3A" HorizontalAlignment="Center" Margin="0,0,0,30"/>
                <TextBlock Text="Event Name" Foreground="#888888" FontSize="13" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEventTitle" Background="#FFFFFF" Foreground="#333333"
                         BorderBrush="#BDBDBD" Padding="6,4" Margin="0,0,0,15" FontSize="15" Height="38"/>
                <TextBlock Text="Date" Foreground="#888888" FontSize="13" Margin="0,0,0,5"/>
                <DatePicker x:Name="DpEventDate" Background="#FFFFFF" Foreground="#333333"
                            BorderBrush="#BDBDBD" Margin="0,0,0,15" FontSize="15" Height="38"/>
                <TextBlock Text="Category" Foreground="#888888" FontSize="13" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbEventType" Background="#FFFFFF" Foreground="#333333"
                          BorderBrush="#BDBDBD" Margin="0,0,0,35" FontSize="15" Height="38">
                    <ComboBoxItem Content="Meeting" Tag="#DDD6FE"/>
                    <ComboBoxItem Content="Deadline" Tag="#FECACA"/>
                    <ComboBoxItem Content="Salary Payout" Tag="#BBF7D0"/>
                    <ComboBoxItem Content="Holiday" Tag="#BFDBFE"/>
                </ComboBox>
                <Button Click="BtnSave_Click" Height="48" Background="#1C1A3A" Foreground="White"
                        BorderBrush="{x:Null}" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="24">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="SAVE EVENT" FontSize="16" FontWeight="ExtraBold"/>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>