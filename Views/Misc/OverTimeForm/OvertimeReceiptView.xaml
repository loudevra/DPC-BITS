<UserControl x:Class="DPC.Views.Misc.OverTime.OvertimeReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#D9D9D9"
             FontFamily="{StaticResource Lexend}"
             Foreground="#474747">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="25,15,25,10">
            <Button x:Name="BtnBack" Click="BtnBack_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0">
                <materialDesign:PackIcon Kind="ArrowLeft" Width="25" Height="25" Foreground="#474747"/>
            </Button>
            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="35" Height="35" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Overtime Request Receipt" FontSize="25" FontWeight="DemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="10" Margin="25,0,25,25" Padding="30">
                <StackPanel>

                    <!-- COMPANY NAME -->
                    <TextBlock Text="DREAM PC BUILD AND IT SOLUTIONS INC." FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="Overtime Request Receipt" FontSize="14" TextAlignment="Center" Foreground="Gray" Margin="0,0,0,20"/>
                    <Separator Margin="0,0,0,20"/>

                    <!-- REF # AND STATUS -->
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="REFERENCE #" FontWeight="Bold" FontSize="13" Foreground="Gray"/>
                            <TextBlock x:Name="TxtOvertimeID" FontSize="15" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="STATUS" FontWeight="Bold" FontSize="13" Foreground="Gray"/>
                            <TextBlock x:Name="TxtStatus" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,15"/>

                    <!-- EMPLOYEE INFO -->
                    <TextBlock Text="EMPLOYEE INFORMATION" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#474747"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="EMPLOYEE NAME" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtEmployeeName" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock Text="EMPLOYEE ID" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtEmployeeID" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="JOB TITLE" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtJobTitle" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Margin="0,0,0,10">
                            <TextBlock Text="DEPARTMENT" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtDepartment" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,0,10">
                            <TextBlock Text="SUPERVISOR" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtSupervisor" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,15"/>

                    <!-- OVERTIME DETAILS -->
                    <TextBlock Text="OVERTIME DETAILS" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#474747"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="START TIME" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtStartTime" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="END TIME" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtEndTime" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                            <TextBlock Text="TOTAL HOURS" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtTotalHours" FontSize="14" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="REASON" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="TxtReason" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="REMARKS" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                        <TextBlock x:Name="TxtRemarks" FontSize="14" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,15"/>

                    <!-- APPROVAL INFO -->
                    <TextBlock Text="APPROVAL INFORMATION" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#474747"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,0,10">
                            <TextBlock Text="REQUESTED BY" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtRequestedBy" FontSize="14"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,0,10">
                            <TextBlock Text="REQUEST DATE" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                            <TextBlock x:Name="TxtRequestDate" FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <!-- PRINT BUTTON -->
                    <!--  <Button x:Name="BtnPrint" Click="BtnPrint_Click" 
                            Background="#52C69D" BorderThickness="0" 
                            Width="200" HorizontalAlignment="Right" 
                            Cursor="Hand" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Printer" Width="20" Height="20" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PRINT RECEIPT" Foreground="White" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button> -->

                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>