<UserControl x:Class="DPC.Views.Misc.OverTime.PreviewPrintOverTimeRequestForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="#D9D9D9">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel LastChildFill="False" Margin="20,20,20,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Content="Cancel" Margin="0,0,5,0" Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="20" Foreground="Gray" BorderBrush="Gray" FontWeight="SemiBold" FontSize="14px" Width="80" Height="35"/>
                        <Button Content="Print" Click="SavePrint" Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="20" Foreground="White" FontWeight="SemiBold" FontSize="14px" Width="80" Height="35" Background="#2E466B"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel x:Name="PrintPreview" Grid.Row="1" Margin="20,10,20,20" HorizontalAlignment="Center" VerticalAlignment="Top">

                    <Border Width="793" Height="560" Background="White" CornerRadius="0,0,10,10" BorderThickness="0" Padding="15">
                        <Grid>
                            <Image Source="/Assets/images/DREAMPCBUILD WATERMARK SLANTED SPACED.png" Stretch="UniformToFill" Opacity="0.05" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,10" Background="Transparent" Grid.RowSpan="2">
                                    <Border Width="60" Height="60" Background="Black">
                                        <Border.OpacityMask>
                                            <ImageBrush ImageSource="/Assets/images/logo.png"/>
                                        </Border.OpacityMask>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,10">
                                    <TextBlock Text="OVERTIME REQUEST FORM" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="20" Foreground="#090909" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="EMPLOYEE NAME" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="JOB TITLE" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,0,0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="EMPLOYEE ID" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource Lexend}" FontSize="11"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="OVERTIME DATE" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource Lexend}" FontSize="11"/>

                                <Border Grid.Row="3" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Height="25">
                                    <TextBlock x:Name="EmployeeName" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Height="25" Margin="-1,0,0,0">
                                    <TextBlock x:Name="Jobtitle" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Height="25" Margin="-1,0,0,0">
                                    <TextBlock x:Name="EmployeeID" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="3" BorderBrush="Gray" BorderThickness="1" Height="25" Margin="-1,0,0,0">
                                    <TextBlock x:Name="OvertimeDate" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Margin="3,8,0,2">
                                    <TextBlock Text="SUPERVISOR" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="0,0,3,0"/>
                                    <TextBlock Text="(If Applicable)" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="9" VerticalAlignment="Bottom"/>
                                </StackPanel>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="DEPARTMENT" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,8,0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="START TIME" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,8,0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="END TIME" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,8,0,2"/>

                                <Border Grid.Row="5" Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Height="25">
                                    <TextBlock x:Name="SupervisorName" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Margin="-1,0,0,0" Height="25">
                                    <TextBlock x:Name="Department" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Margin="-1,0,0,0" Height="25">
                                    <TextBlock x:Name="StartTime" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="5" Grid.Column="3" BorderBrush="Gray" BorderThickness="1" Margin="-1,0,0,0" Height="25">
                                    <TextBlock x:Name="EndTime" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Text="REASON FOR OVERTIME" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,8,0,2"/>
                                <TextBlock Grid.Row="6" Grid.Column="3" Text="TOTAL HOURS" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,8,0,2"/>

                                <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" BorderBrush="Gray" BorderThickness="1" Height="25">
                                    <TextBlock x:Name="Reason" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="7" Grid.Column="3" BorderBrush="Gray" BorderThickness="1" Margin="-1,0,0,0" Height="25">
                                    <TextBlock x:Name="TotalHours" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="REMARKS / EXPLANATION:" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,8,0,2"/>
                                <Border Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4" BorderBrush="Gray" BorderThickness="1" >
                                    <TextBlock x:Name="Remarks" Text="" FontSize="12" HorizontalAlignment="Left" Height="50" Padding="5" TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="REQUESTED BY:" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,15,0,2"/>
                                <TextBlock Grid.Row="10" Grid.Column="1" Text="DATE" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,15,0,2"/>
                                <TextBlock Grid.Row="10" Grid.Column="2" Text="APPROVED BY:" TextAlignment="Left" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,15,0,2"/>
                                <TextBlock Grid.Row="10" Grid.Column="3" Text="DATE OF APPROVAL" TextAlignment="Center" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,15,0,2"/>

                                <Border Grid.Row="11" Grid.Column="0" BorderBrush="Gray" BorderThickness="1,1,0.2,1" Height="25">
                                    <TextBlock x:Name="RequestedBy" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="11" Grid.Column="1" BorderBrush="Gray" BorderThickness="0.2, 1,1,1" Height="25">
                                    <TextBlock x:Name="RequestedDate" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="11" Grid.Column="2" BorderBrush="Gray" BorderThickness="1,1,0.2,1" Margin="-1,0,0,0" Height="25">
                                    <TextBlock x:Name="ApprovedBy" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="11" Grid.Column="3" BorderBrush="Gray" BorderThickness="0.2,1,1,1" Height="25">
                                    <TextBlock x:Name="ApprovalDate" Text="" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="4" Text="INSTRUCTIONS:" FontWeight="Bold" FontFamily="{StaticResource Lexend}" FontSize="11" Margin="3,15,0,2"/>

                                <TextBlock Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="4" FontFamily="{StaticResource Lexend}" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="3,0,0,0">
                                    <Run Text="No overtime will be paid unless this form has been completed prior to overtime."/>
                                    <LineBreak/>
                                    <Run Text="It is the responsibility of the employee to submit a signed timesheet for specific overtime work."/>
                                    <LineBreak/>
                                    <Run Text="• For Technician's: Every Friday Cutoff  |  • For In-house: Every 10th and 25th of the Month"/>
                                    <LineBreak/>
                                    <Run Text="The form must be returned to the immediate."/>
                                </TextBlock>

                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>