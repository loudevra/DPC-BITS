<UserControl x:Class="DPC.Views.Misc.OverTime.OverTimeRequestForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="#D9D9D9"
             FontFamily="{StaticResource Lexend}"
             Foreground="#474747"
             d:DesignHeight="950" d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="{Binding Background, RelativeSource={RelativeSource FindAncestor, AncestorType=UserControl}}" Margin="25,10,25,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="ClockTimeFourOutline" Width="40" Height="40" Margin="0,0,15,0"/>
                <TextBlock Text="Overtime Request Form" FontSize="25" FontWeight="DemiBold" VerticalAlignment="Center" Margin="0,0,0,-3"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ModernScrollViewerStyle}">
            <StackPanel Orientation="Vertical" Margin="0,10,0,0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EMPLOYEE NAME" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Center" Margin="10,0,0,5"/>
                            <TextBlock Text=" *" Foreground="Red" FontSize="16" FontWeight="UltraBold"/>
                        </StackPanel>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <Grid>
                                <TextBox x:Name="AutoCompleteTextBox" FontFamily="{StaticResource Lexend}" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" VerticalAlignment="Top"
                     TextChanged="AutoCompleteTextBox_TextChanged"
                     PreviewKeyDown="AutoCompleteTextBox_PreviewKeyDown"/>

                                <Popup x:Name="AutoCompletePopup" Placement="Bottom" PlacementTarget="{Binding ElementName=AutoCompleteTextBox}" StaysOpen="False" AllowsTransparency="True" Focusable="False" IsOpen="False">
                                    <Border Background="White" BorderBrush="Gray" BorderThickness="1" CornerRadius="5">
                                        <ListBox x:Name="SuggestionListBox" PreviewMouseLeftButtonUp="SuggestionListBox_PreviewMouseLeftButtonDown" FontFamily="{StaticResource Lexend}" FontSize="14" Width="{Binding ActualWidth, ElementName=AutoCompleteTextBox}" MaxHeight="150" Padding="3" BorderThickness="0" />
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0" Margin="10">
                        <TextBlock Text="JOB TITLE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="JobTitle" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="10">
                        <TextBlock Text="EMPLOYEE ID" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="EmployeeID" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center" IsReadOnly="True"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DATE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                            <TextBlock Text=" *" Foreground="Red" FontSize="16" FontWeight="UltraBold"/>
                        </StackPanel>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=".15*"/>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="CashAdvanceDatePicker" SelectedDateChanged="MainDate_Changed" Style="{StaticResource SingleDatePickerStyle}" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="25" Height="25" Foreground="#474747" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                                <Button Grid.Column="1" Click="CashAdvanceDate_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand" Height="35">
                                    <TextBlock Text="{Binding ElementName=CashAdvanceDatePicker, Path=SelectedDate, StringFormat='MMMM dd, yyyy', TargetNullValue='Select Date'}" FontFamily="{StaticResource Lexend}" FontSize="14" Foreground="#474747" VerticalAlignment="Center"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="SUPERVISOR (If Applicable)" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="SupervisorName" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Text="DEPARTMENT" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="hourlyRate" Height="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#474747" Padding="5,5,5,5" CornerRadius="20,0,0,0" Grid.Column="0">
                        <TextBlock Text="DATE" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Foreground="#d9d9d9"/>
                    </Border>
                    <Border Background="#474747" Padding="5,10,5,10" Grid.Column="1">
                        <TextBlock Text="START TIME" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Foreground="#d9d9d9"/>
                    </Border>
                    <Border Background="#474747" Padding="5,10,5,10" Grid.Column="2">
                        <TextBlock Text="END TIME" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Foreground="#d9d9d9"/>
                    </Border>
                    <Border Background="#474747" Padding="5,10,5,10" Grid.Column="3">
                        <TextBlock Text="REASON" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="14" TextAlignment="Center" Foreground="#d9d9d9"/>
                    </Border>
                    <Border Background="#474747" Padding="5,10,5,10" CornerRadius="0,20,0,0" Grid.Column="4">
                        <TextBlock Text="ANTICIPATED NUMBER OF OVERTIME HOURS" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="13" TextAlignment="Center" Foreground="#d9d9d9" TextWrapping="Wrap" VerticalAlignment="Bottom"/>
                    </Border>

                    <StackPanel x:Name="SPRequestAmount" Grid.Column="0" Grid.ColumnSpan="5" Grid.Row="1">
                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,5,0" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <DatePicker x:Name="dtOvertimeDate" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>

                                    <Button Grid.ColumnSpan="2" Click="OvertimeDate_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Center" Height="35">
                                        <TextBlock Text="{Binding ElementName=dtOvertimeDate, Path=SelectedDate, StringFormat='MMMM dd, yyyy', TargetNullValue='Select Date'}" 
                               FontFamily="{StaticResource Lexend}" Foreground="#474747" VerticalAlignment="Center" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,5,0" Background="White" Padding="5,0,5,0">
                                <TextBox x:Name="txtStartTime" 
                     Height="35" 
                     VerticalContentAlignment="Center" 
                     FontFamily="{StaticResource Lexend}" 
                     TextAlignment="Center" 
                     FontSize="14" 
                     Background="Transparent" 
                     BorderThickness="0"
                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                     materialDesign:HintAssist.Hint="00:00 AM"/>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,5,0" Background="White" Padding="5,0,5,0">
                                <TextBox x:Name="txtEndTime" 
                     Height="35" 
                     VerticalContentAlignment="Center" 
                     FontFamily="{StaticResource Lexend}" 
                     TextAlignment="Center" 
                     FontSize="14" 
                     Background="Transparent" 
                     BorderThickness="0"
                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                     materialDesign:HintAssist.Hint="00:00 PM"/>
                            </Border>

                            <Border Grid.Column="3" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,5,0" Background="White" Padding="5,0,5,0">
                                <TextBox x:Name="txtReason" 
                     Height="35" 
                     VerticalContentAlignment="Center" 
                     FontFamily="{StaticResource Lexend}" 
                     TextAlignment="Center" 
                     FontSize="14"
                     Background="Transparent" 
                     BorderThickness="0"
                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,0" Background="White" Padding="5,0,5,0">
                                <TextBox x:Name="txtHours" 
                     Height="35" 
                     VerticalContentAlignment="Center" 
                     FontFamily="{StaticResource Lexend}" 
                     TextAlignment="Center" 
                     FontSize="14" 
                     FontWeight="Bold"
                     Background="Transparent" 
                     BorderThickness="0"
                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="5" Margin="0,20,0,0">
                        <TextBlock Text="Please provide an explanation of the work that requires more than 8 hours per day to complete." FontFamily="{StaticResource Lexend}" FontWeight="SemiBold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                        <Border Style="{StaticResource RoundedBorderStyle}" Padding="0,5,0,5">
                            <TextBox FontFamily="{StaticResource Lexend}" x:Name="approverRemarks" MinHeight="40" Height="Auto" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Left" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="4" Grid.ColumnSpan="5" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.8*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="REQUESTED BY:" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                            <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747">
                                <TextBox FontFamily="{StaticResource Lexend}" x:Name="TxtRequestedBy" MinHeight="35" Style="{StaticResource RoundedTextboxStyle}" FontSize="14" TextAlignment="Left"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="5,0,10,0">
                            <TextBlock Text="DATE:" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                            <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747" Height="39">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width=".2*"/>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="RequestDate" Style="{StaticResource SingleDatePickerStyle}" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="20" Height="20" Foreground="#474747" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Click="RequestDate_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                        <TextBlock Text="{Binding ElementName=RequestDate, Path=SelectedDate, StringFormat='MMMM dd, yyyy'}" FontFamily="{StaticResource Lexend}" Foreground="#474747"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="5,0,10,0">
                            <TextBlock Text="APPROVED BY:" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                            <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747" Height="39">
                                <ComboBox Style="{StaticResource RoundedComboBoxStyle}" BorderThickness="0" Margin="15,0,0,0" x:Name="CbApprover" FontFamily="{StaticResource Lexend}" FontSize="14">
                                    <ComboBoxItem Content="None"/>
                                    <ComboBoxItem Content="Parvit Kumar"/>
                                    <ComboBoxItem Content="Alecksandra Balingit"/>
                                </ComboBox>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="5,0,0,0">
                            <TextBlock Text="DATE OF APPROVAL:" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16" TextAlignment="Left" Margin="10,0,0,5"/>
                            <Border CornerRadius="20" Background="White" BorderThickness="2" BorderBrush="#474747" Height="39">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width=".2*"/>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="ApprovalDate" Style="{StaticResource SingleDatePickerStyle}" Width="0" Opacity="0" Focusable="False" IsHitTestVisible="False"/>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="20" Height="20" Foreground="#474747" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Click="ApprovalDate_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand">
                                        <TextBlock Text="{Binding ElementName=ApprovalDate, Path=SelectedDate, StringFormat='MMMM dd, yyyy'}" FontFamily="{StaticResource Lexend}" Foreground="#474747"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="5" Grid.ColumnSpan="5" Background="#F0F0F0" BorderBrush="#474747" BorderThickness="1" CornerRadius="5" Margin="0,20,0,0" Padding="15">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="INSTRUCTIONS" FontFamily="{StaticResource Lexend}" FontWeight="Bold" FontSize="16"/>
                            </StackPanel>
                            <TextBlock FontFamily="{StaticResource Lexend}" FontSize="13" TextWrapping="Wrap" LineHeight="20"><Run Text="No overtime will be paid unless this form has been completed prior to overtime."/><LineBreak/><Run Text="It is the responsibility of the employee to submit a signed timesheet for specific overtime work."/><Run Language="en-ph" Text=" The employee must do this payroll is completed."/><LineBreak/><Run Text="• For Technician's:"/><Run Text=" Every Friday Cutoff | "/><Run Text="• For In-house:"/><Run Text=" Every 10th and 25th of the Month"/><LineBreak/><Run Text="The form must be returned to the immediate."/></TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource RoundedButtonStyle}" x:Name="BtnSubmit" BorderThickness="0" FontSize="16" FontFamily="{StaticResource Lexend}" Width="200" Grid.Row="6" Grid.ColumnSpan="5" HorizontalAlignment="Right" Margin="0,20,0,20" Cursor="Hand" Background="#52C69D">
                        <TextBlock Text="SUBMIT REQUEST" TextAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
                    </Button>

                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>