<UserControl x:Class="DPC.Components.Forms.AddHoliday"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="Auto"
             FontFamily="{StaticResource Lexend}"
             Background="Transparent">

    <materialDesign:Card Width="450" Padding="20" Background="White"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            UniformCornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="ShapeRectanglePlus" Width="40" Height="40" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#555555"/>
                <TextBlock FontSize="20" Foreground="#555555" FontWeight="Bold" Text="Add Holiday" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent" x:Name="BtnClose">
                <materialDesign:PackIcon Kind="Close" Foreground="#555555" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>

            <StackPanel Grid.Row="1">

                <StackPanel Margin="0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="From:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource RoundedBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".05*"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="32" Height="25" Foreground="#474747" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="10,0,0,0"/>

                            <Button Grid.Column="1" Style="{StaticResource DateButtonStyle}" Width="Auto" Margin="28,0,25,0" Click="BtnFrom_Click">
                                <TextBlock x:Name="txtFromDate" Text="{Binding SelectedDate, ElementName=dpFromHidden, StringFormat={}{0:MM/dd/yyyy}}" Margin="0,0,5,0" Height="14" FontFamily="Lexend" Foreground="#555555" FontWeight="SemiBold" />
                            </Button>

                            <DatePicker x:Name="dpFromHidden" Width="0" Height="0" Opacity="0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="To:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource RoundedBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width=".05*"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="32" Height="25" Foreground="#474747" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="10,0,0,0"/>

                            <Button Grid.Column="1" Style="{StaticResource DateButtonStyle}" Width="Auto" Margin="28,0,25,0" Click="BtnTo_Click">
                                <TextBlock x:Name="txtToDate" Text="{Binding SelectedDate, ElementName=dpToHidden, StringFormat={}{0:MM/dd/yyyy}}" Margin="0,0,5,0" Height="14" FontFamily="Lexend" Foreground="#555555" FontWeight="SemiBold" />
                            </Button>

                            <DatePicker x:Name="dpToHidden" Width="0" Height="0" Opacity="0" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Note:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                </StackPanel>
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,10" Height="129" Padding="0,15,0,15">
                    <TextBox x:Name="TxtNote" Style="{StaticResource RoundedTextboxStyle}" Height="Auto" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Lexend" Foreground="#555555" FontWeight="SemiBold" CharacterCasing="Upper" AcceptsReturn="True"/>
                </Border>

                <Button x:Name="BtnAdd" Click="BtnAdd_Click" 
        Style="{StaticResource RoundedButtonStyle}" 
        BorderThickness="0" Background="#52C69D" 
        Padding="10,5">
                    <TextBlock x:Name="TxtBtnAdd" Text="Add" VerticalAlignment="Center" HorizontalAlignment="Center" 
               Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>

        </Grid>
    </materialDesign:Card>
</UserControl>