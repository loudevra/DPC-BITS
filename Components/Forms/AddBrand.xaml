<UserControl x:Class="DPC.Components.Forms.AddBrand"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="Auto"
             FontFamily="{StaticResource Lexend}"
             Background="Transparent">
    <materialDesign:Card Width="450" Padding="20" Background="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         UniformCornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="TextBoxOutline" Width="40" Height="40" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#555555"/>
                <TextBlock FontSize="20" Foreground="#555555" FontWeight="Bold" Text="Add Brand" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <!-- Brand Name -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Name:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                </StackPanel>
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,20">
                    <TextBox x:Name="TxtBrand"
                             Style="{StaticResource RoundedTextboxStyle}"
                             CharacterCasing="Upper"
                             TextChanged="TxtBrand_TextChanged"/>
                </Border>
                <!-- Category -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Category:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                </StackPanel>
                <ComboBox x:Name="CmbCategory"
                          Style="{StaticResource RoundedComboBoxStyle}"
                          Width="Auto"
                          Height="40"
                          Margin="0,0,0,20"
                          FontFamily="{StaticResource Lexend}"
                          Foreground="#474747"
                          FontWeight="SemiBold"/>
                <!-- Add Button -->
                <Button Style="{StaticResource RoundedButtonStyle}" BorderThickness="0" Background="#52C69D" Click="BtnAddBrand">
                    <TextBlock Text="Add" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="15"/>
                </Button>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>