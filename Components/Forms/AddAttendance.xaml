<UserControl x:Class="DPC.Components.Forms.AddAttendance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="Auto"
             FontFamily="{StaticResource Lexend}"
             Background="Transparent">

    <materialDesign:Card Width="450" Padding="20" Background="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         UniformCornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon x:Name="IconTitle" Kind="ShapeRectanglePlus" Width="40" Height="40" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#555555"/>
                <TextBlock x:Name="TxtTitle" FontSize="20" Foreground="#555555" FontWeight="Bold" Text="Add Attendance" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent" x:Name="BtnClose">
                <materialDesign:PackIcon Kind="Close" Foreground="#555555" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>

            <StackPanel Grid.Row="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Employees:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0" />
                </StackPanel>
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,10" Padding="10,0">
                    <TextBox x:Name="TxtEmployee" Style="{StaticResource RoundedTextboxStyle}" FontFamily="Lexend" Foreground="#555555" FontWeight="SemiBold" CharacterCasing="Upper"/>
                </Border>

                <StackPanel Margin="0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Date:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource RoundedBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <DatePicker x:Name="SingleDatePicker"
                                        SelectedDateChanged="SingleDatePicker_SelectedDateChanged"
                                        Opacity="0" Width="0" IsHitTestVisible="False" />

                            <Button x:Name="DateButton" Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0" Click="StartDate_Click" HorizontalContentAlignment="Left" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Calendar" Width="25" Height="25" Foreground="#474747" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="TxtDateDisplay" Text="Select a date" VerticalAlignment="Center" FontFamily="Lexend" Foreground="#555555" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="From:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                </StackPanel>
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,10" Padding="10,0">
                    <materialDesign:TimePicker x:Name="TpStartTime" Is24Hours="False" BorderThickness="0" Background="Transparent" FontFamily="Lexend" Foreground="#555555" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="To:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                </StackPanel>
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,20" Padding="10,0">
                    <materialDesign:TimePicker x:Name="TpEndTime" Is24Hours="False" BorderThickness="0" Background="Transparent" FontFamily="Lexend" Foreground="#555555" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Note:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" Margin="0,0,5,0"/>
                </StackPanel>
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,10" Height="100" Padding="10">
                    <TextBox x:Name="TxtNote" Style="{StaticResource RoundedTextboxStyle}" Height="Auto" TextWrapping="Wrap" VerticalAlignment="Top" FontFamily="Lexend" Foreground="#555555" FontWeight="SemiBold" CharacterCasing="Upper" AcceptsReturn="True"/>
                </Border>

                <Button x:Name="BtnAdd" Click="BtnAdd_Click" Style="{StaticResource RoundedButtonStyle}" BorderThickness="0" Background="#52C69D" Height="40" Margin="0,10,0,0">
                    <TextBlock x:Name="TxtBtnAdd" Text="Add" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>