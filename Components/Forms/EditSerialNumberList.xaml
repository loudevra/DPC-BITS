<UserControl x:Class="DPC.Components.Forms.EditSerialNumberList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="Auto"
             FontFamily="{StaticResource Lexend}"
             Background="Transparent">

    <materialDesign:Card Width="450" Padding="20" Background="White"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            UniformCornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="FileDocumentEdit" Width="40" Height="40" Margin="0,0,15,0" VerticalAlignment="Center" Foreground="#555555"/>
                <TextBlock FontSize="20" Foreground="#555555" FontWeight="Bold" Text="Edit Serial Number(s)" Margin="0,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnDeleteAll"
                            Grid.Column="0"
                            Grid.Row="0"
                            Margin="0,0,10,0"
                            Height="45"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="Red" 
                            BorderBrush="Red"
                            materialDesign:ButtonAssist.CornerRadius="20">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteSweep" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="DELETE ALL" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnSaveDelivery"
                            Grid.Column="1"
                            Grid.Row="0"
                            Margin="10,0,0,0"
                            Height="45"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="ForestGreen"
                            BorderBrush="ForestGreen"
                            materialDesign:ButtonAssist.CornerRadius="20">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveCheck" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="SAVE" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
                    <ScrollViewer Grid.Row="1" 
                          Grid.ColumnSpan="2" 
                          MaxHeight="300" 
                          Margin="0,20,0,0" 
                          VerticalScrollBarVisibility="Auto">

                        <StackPanel x:Name="SerialNumberList">
                        </StackPanel>

                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </Grid>
    </materialDesign:Card>
</UserControl>
