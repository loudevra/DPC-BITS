<Window x:Class="DPC.Components.Forms.EditWarehouse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Edit Warehouse"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Width="450"
        Height="Auto"
        FontFamily="{StaticResource Lexend}">

    <Grid>
        <materialDesign:Card Width="420" Padding="20" Background="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             UniformCornerRadius="20" BorderBrush="#555555" BorderThickness="2">
            <StackPanel>
                <!-- Header -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="TextBoxOutline" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="#555555"/>
                        <TextBlock FontSize="20" Foreground="#555555" FontWeight="Bold" Text="Edit Warehouse" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}"
                            Click="ClosePopup"
                            Background="Transparent" Foreground="Black" VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="Close" />
                    </Button>
                </Grid>

                <Separator Margin="0,10,0,10"/>

                <!-- Name -->
                <TextBlock Text="Name:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" />
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,10" CornerRadius="15">
                    <TextBox x:Name="TxtWarehouseName" Style="{StaticResource RoundedTextboxStyle}" Height="Auto" FontSize="14" Margin="10,5,10,5"/>
                </Border>

                <!-- Total Products -->
                <TextBlock Text="Total Products:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" />
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,10" CornerRadius="15">
                    <TextBox x:Name="TxtTotalProducts" Style="{StaticResource RoundedTextboxStyle}" Height="Auto" FontSize="14" Margin="10,5,10,5" />
                </Border>

                <!-- Stock Quantity -->
                <TextBlock Text="Stock Quantity:" Foreground="#555555" FontSize="14" FontWeight="SemiBold" />
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,10" CornerRadius="15">
                    <TextBox x:Name="TxtStockQuantity" Style="{StaticResource RoundedTextboxStyle}" Height="Auto" FontSize="14" Margin="10,5,10,5"/>
                </Border>

                <!-- Worth -->
                <TextBlock Text="Worth (Sales/Stocks):" Foreground="#555555" FontSize="14" FontWeight="SemiBold" />
                <Border Style="{StaticResource RoundedBorderStyle}" Margin="0,0,0,20" CornerRadius="15">
                    <TextBox x:Name="TxtWorth" Style="{StaticResource RoundedTextboxStyle}" Height="Auto" FontSize="14" Margin="10,5,10,5"/>
                </Border>

                <!-- Update Button (rounded template to match AddWarehouse) -->
                <Button x:Name="btnUpdate" Content="Update" Click="UpdateWarehouse_Click"
                        Height="45" Background="#58D68D" Foreground="White"
                        Margin="0,0,0,0" FontSize="16">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="20"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
