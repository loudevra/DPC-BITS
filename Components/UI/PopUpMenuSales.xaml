<UserControl x:Class="DPC.Components.UI.PopUpMenuSales"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Height="Auto" Width="Auto"
             Background="Transparent">

    <UserControl.Resources>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubmenuItemStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#d4d4d4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="25,3,0,3"/>
        </Style>

        <Style x:Key="MainMenuItemStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Lexend"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="VerticalLineStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Column="1" Grid.Row="1" Background="#0F0F0F" UniformCornerRadius="0" Margin="0" Width="285">
            <StackPanel Orientation="Vertical" Margin="35,0,0,0" Height="479">

                <StackPanel Visibility="Collapsed">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Send" Foreground="White" Width="20" Height="20" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1">
                            <Hyperlink>
                                <TextBlock Text="POS Sales" Style="{StaticResource MainMenuItemStyle}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="24,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Width="1" Fill="#444444" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToNewPOSInvoice">
                                    <TextBlock Text="New Invoice" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a new invoice for clients." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToNewInvoiceV2">
                                    <TextBlock Text="New Invoice V2 - Mobile" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Generate invoices optimized for mobile." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageInvoices">
                                    <TextBlock Text="Manage Invoices" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Edit, send, and track all invoices." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="Collapsed">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Cart" Foreground="White" Width="20" Height="20" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1">
                            <Hyperlink>
                                <TextBlock Text="Sales" Style="{StaticResource MainMenuItemStyle}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="24,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Width="1" Fill="#444444" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToNewInvoice">
                                    <TextBlock Text="New Invoice" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a new invoice for clients." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageInvoices">
                                    <TextBlock Text="Manage Invoices" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Edit, send, and track all invoices." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Calculator" Foreground="White" Width="20" Height="20" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1">
                            <Hyperlink>
                                <TextBlock Text="Cost Estimate" Style="{StaticResource MainMenuItemStyle}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="24,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Width="1" Fill="#444444" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToNewQuote">
                                    <TextBlock Text="New Private Cost Estimate" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a new cost estimate for projects or services." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageQuote">
                                    <TextBlock Text="Manage Cost Estimate" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="View and manage all cost estimates." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToNewQuoteGovernment">
                                    <TextBlock Text="New Gov Cost Estimate" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend" Visibility="Collapsed" />
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a government cost estimate." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageQuoteGovernment">
                                    <TextBlock Text="Manage Gov Cost Estimate" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend" Visibility="Collapsed" />
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Manage a government cost estimate." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Receipt" Foreground="White" Width="20" Height="20" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1">
                            <Hyperlink>
                                <TextBlock Text="Billing Statement" Style="{StaticResource MainMenuItemStyle}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="24,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62*"/>
                            <ColumnDefinition Width="163*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Width="1" Fill="#444444" HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToWalkIn">
                                    <TextBlock Text="New Billing Statement" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a new cost estimate for projects or services." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageWalkInClients">
                                    <TextBlock Text="Manage Billing Statement" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="View and manage all cost estimates." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink>
                                    <TextBlock Text="New Gov Cost Estimate" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend" Visibility="Collapsed" />
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a government cost estimate." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageQuoteGovernment">
                                    <TextBlock Text="Manage Gov Cost Estimate" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend" Visibility="Collapsed" />
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Manage a government cost estimate." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="TruckDelivery" Foreground="White" Width="20" Height="20" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1">
                            <Hyperlink>
                                <TextBlock Text="Delivery Receipt" Style="{StaticResource MainMenuItemStyle}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="24,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="62*"/>
                            <ColumnDefinition Width="163*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Width="1" Fill="#444444" HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Grid.ColumnSpan="2">
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToNewDeliveryReceipt">
                                    <TextBlock Text="New Delivery Receipt" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a new cost estimate for projects or services." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageDeliveryReceipt">
                                    <TextBlock Text="Manage Delivery Receipt" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="View and manage all cost estimates." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToNewQuoteGovernment">
                                    <TextBlock Text="New Gov Cost Estimate" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend" Visibility="Collapsed" />
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a government cost estimate." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageQuoteGovernment">
                                    <TextBlock Text="Manage Gov Cost Estimate" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend" Visibility="Collapsed" />
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Manage a government cost estimate." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Foreground="White" Width="20" Height="20" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1">
                            <Hyperlink>
                                <TextBlock Text="Statement of Account" Style="{StaticResource MainMenuItemStyle}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="24,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Width="1" Fill="#444444" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToStatementOfAccount">
                                    <TextBlock Text="Statement of Account Receipt" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Create a new statement of account." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>

                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToManageStatementOfAccount">
                                    <TextBlock Text="Manage Statement of Account" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="View and manage all statements of account." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="Collapsed">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="SignalCellularOutline" Foreground="White" Width="20" Height="20" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="1">
                            <Hyperlink>
                                <TextBlock Text="Subscription" Style="{StaticResource MainMenuItemStyle}"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>

                    <Grid Margin="24,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle Width="1" Fill="#444444" HorizontalAlignment="Left" Margin="0,0,0,0"/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToNewSubscription">
                                    <TextBlock Text="New Subscription" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="Add a new client subscription plan." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBlock Margin="10,3,0,3">
                                <Hyperlink Click="NavigateToSubscriptions">
                                    <TextBlock Text="Subscriptions" Foreground="#d4d4d4" FontSize="13" FontFamily="Lexend"/>
                                </Hyperlink>
                                <TextBlock.ToolTip>
                                    <ToolTip Content="View and manage all active subscriptions." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Grid Margin="0,8,0,8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="ClipboardText" Foreground="White" Width="20" Height="20" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="1">
                        <Hyperlink Click="NavigateToCreditNotes">
                            <TextBlock Text="Credit Notes" Style="{StaticResource MainMenuItemStyle}"/>
                        </Hyperlink>
                        <TextBlock.ToolTip>
                            <ToolTip Content="Issue credit notes for refunds or adjustments." Style="{StaticResource SpeechBubbleToolTip}" Placement="Top"/>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </Grid>

            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>