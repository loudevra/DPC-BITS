<Window x:Class="DPC.DPC.Components.ConfirmationModals.GlobalSearchModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Search Results" 
        Height="600" 
        Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Border Background="White" CornerRadius="10" BorderThickness="1" BorderBrush="#E0E0E0">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="20" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2196F3" CornerRadius="10,10,0,0" Padding="20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Search Results" FontSize="20" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="SearchQueryText" FontSize="12" Foreground="#E3F2FD" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" 
                            Click="CloseModal"
                            Style="{StaticResource MaterialDesignIconButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="24" Height="24"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Search Results List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SearchResultsList" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                    BorderBrush="#E0E0E0" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Margin="5"
                                    Padding="15"
                                    Cursor="Hand"
                                    MouseEnter="Result_MouseEnter"
                                    MouseLeave="Result_MouseLeave"
                                    MouseLeftButtonDown="Result_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" 
                                            Background="#E3F2FD" 
                                            Width="50" 
                                            Height="50" 
                                            CornerRadius="25"
                                            VerticalAlignment="Center"
                                            Margin="0,0,15,0">
                                        <materialDesign:PackIcon Kind="{Binding Icon}" 
                                                                Width="28" 
                                                                Height="28" 
                                                                Foreground="#2196F3"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold"
                                                   Foreground="#212121"/>
                                        <TextBlock Text="{Binding Subtitle}" 
                                                   FontSize="12" 
                                                   Foreground="#757575"
                                                   Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding AdditionalInfo}" 
                                                   FontSize="11" 
                                                   Foreground="#9E9E9E"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Category Badge -->
                                    <Border Grid.Column="2" 
                                            Background="#FFF3E0" 
                                            CornerRadius="12"
                                            Padding="12,6"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" 
                                                   FontSize="11" 
                                                   FontWeight="Medium"
                                                   Foreground="#F57C00"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- No Results Message -->
            <StackPanel x:Name="NoResultsPanel" 
                        Grid.Row="1" 
                        VerticalAlignment="Center" 
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <materialDesign:PackIcon Kind="Magnify" 
                                        Width="80" 
                                        Height="80" 
                                        Foreground="#BDBDBD"
                                        HorizontalAlignment="Center"/>
                <TextBlock Text="No results found" 
                           FontSize="18" 
                           Foreground="#757575"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
                <TextBlock Text="Try searching with different keywords" 
                           FontSize="12" 
                           Foreground="#9E9E9E"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20">
                <Grid>
                    <TextBlock x:Name="ResultCountText" 
                               Text="0 results found" 
                               FontSize="12" 
                               Foreground="#757575"
                               VerticalAlignment="Center"/>
                    <Button Content="Close" 
                            Click="CloseModal"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>